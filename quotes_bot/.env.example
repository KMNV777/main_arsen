TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
DATABASE_PATH=quotes_bot/data/quotes.db

# HTTPS URL for Telegram Mini App (required for WebApp button)
# start.sh sets this automatically via tunnel. For Russia prefer localhost.run:
# WEBAPP_TUNNEL=localhost   (default, domain *.lhr.life)
# WEBAPP_TUNNEL=cloudflare  (trycloudflare.com — often blocked in RU)
# WEBAPP_TUNNEL=none        — use WEBAPP_URL below as-is (your VPS/domain)
WEBAPP_TUNNEL=localhost
WEBAPP_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8765
