TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
DATABASE_PATH=quotes_bot/data/quotes.db

# HTTPS URL for Telegram Mini App (required for WebApp button)
# start.sh sets WEBAPP_URL automatically. Recommended for RU: auto (Pinggy → localhost → Cloudflare)
# WEBAPP_TUNNEL=auto        (default — tries providers until one works)
# WEBAPP_TUNNEL=pinggy      (Pinggy HTTPS, usually best from RU)
# WEBAPP_TUNNEL=localhost   (localhost.run / lhr.life)
# WEBAPP_TUNNEL=cloudflare  (trycloudflare.com — often blocked in RU)
# WEBAPP_TUNNEL=none        — use WEBAPP_URL below as-is (your VPS/domain)
WEBAPP_TUNNEL=auto
WEBAPP_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8765
