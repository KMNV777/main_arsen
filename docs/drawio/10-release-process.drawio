gBottom=2;" vertex="1" parent="1"><mxGeometry x="929" y="279" width="22" height="22" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;6&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=2;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1069" y="279" width="22" height="22" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;7&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=2;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1564" y="179" width="22" height="22" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;8&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=2;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1304" y="109" width="22" height="22" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;B. Что означает каждая отметка (шаг → ответственный → правило)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="900" height="22" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;№&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="498" width="40" height="24" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Шаг&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="498" width="150" height="24" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Отв.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="210" y="498" width="170" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Правило&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="380" y="498" width="750" height="24" as="geometry"/></mxCell><mxCell id="c27" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="522" width="40" height="36" as="geometry"/></mxCell><mxCell id="c28" value="0.2 Ветка" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="522" width="150" height="36" as="geometry"/></mxCell><mxCell id="c29" value="Релиз-инженер НЕДРА + мейнтейнер" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="210" y="522" width="170" height="36" as="geometry"/></mxCell><mxCell id="c30" value="Режется в начале спринта от master; SHA в паспорте. Имя: release/&amp;lt;сервис&amp;gt;/&amp;lt;версия&amp;gt;. Один сервис — одна ветка на релиз." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="380" y="522" width="750" height="36" as="geometry"/></mxCell><mxCell id="c31" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="558" width="40" height="36" as="geometry"/></mxCell><mxCell id="c32" value="1.1 Слияние PR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="558" width="150" height="36" as="geometry"/></mxCell><mxCell id="c33" value="Мейнтейнер" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="210" y="558" width="170" height="36" as="geometry"/></mxCell><mxCell id="c34" value="В ветку идёт только Story/Bug с fixVersion, тест-кейсами, оценкой и traceability PR → ключ Story. Без тест-кейсов — не вливается (исключение: Release owner + QA)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="380" y="558" width="750" height="36" as="geometry"/></mxCell><mxCell id="c35" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="594" width="40" height="24" as="geometry"/></mxCell><mxCell id="c36" value="1.2 Scope freeze" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="594" width="150" height="24" as="geometry"/></mxCell><mxCell id="c37" value="Release owner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="210" y="594" width="170" height="24" as="geometry"/></mxCell><mxCell id="c38" value="После freeze Fix Version блокируется; новый состав — только через change control с записью причины (код E1)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="380" y="594" width="750" height="24" as="geometry"/></mxCell><mxCell id="c39" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="618" width="40" height="24" as="geometry"/></mxCell><mxCell id="c40" value="1.3 Freeze ветки" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="618" width="150" height="24" as="geometry"/></mxCell><mxCell id="c41" value="Мейнтейнер" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="210" y="618" width="170" height="24" as="geometry"/></mxCell><mxCell id="c42" value="Ветка заморожена, сборка rc на UAT; тест-планы UAT — в ТестОпс НЕДРА." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="380" y="618" width="750" height="24" as="geometry"/></mxCell><mxCell id="c43" value="5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="642" width="40" height="24" as="geometry"/></mxCell><mxCell id="c44" value="4.3 Фиксы UAT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="642" width="150" height="24" as="geometry"/></mxCell><mxCell id="c45" value="Фича-команды" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="210" y="642" width="170" height="24" as="geometry"/></mxCell><mxCell id="c46" value="Только коммиты по заведённым Bug и замечаниям ИБ; после последнего фикса — повторный скан в CI." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="380" y="642" width="750" height="24" as="geometry"/></mxCell><mxCell id="c47" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="666" width="40" height="24" as="geometry"/></mxCell><mxCell id="c48" value="G1 Код-фриз" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="666" width="150" height="24" as="geometry"/></mxCell><mxCell id="c49" value="Release owner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="210" y="666" width="170" height="24" as="geometry"/></mxCell><mxCell id="c50" value="Фиксируется hash/образ. Аудит (5.x), ПТЗ, трансфер, PreProd и Прод работают с этим же hash; иначе возврат на 4.3 и повтор G1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="380" y="666" width="750" height="24" as="geometry"/></mxCell><mxCell id="c51" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="40" height="36" as="geometry"/></mxCell><mxCell id="c52" value="12.5 Тег и merge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="150" height="36" as="geometry"/></mxCell><mxCell id="c53" value="Релиз-инженер НЕДРА + мейнтейнер" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="210" y="690" width="170" height="36" as="geometry"/></mxCell><mxCell id="c54" value="После стабильного Прода: тег v&amp;lt;версия&amp;gt;, release → master, перенос в открытые release/* (следующий релиз уже в работе)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="380" y="690" width="750" height="36" as="geometry"/></mxCell><mxCell id="c55" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="726" width="40" height="36" as="geometry"/></mxCell><mxCell id="c56" value="HF Hotfix" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="726" width="150" height="36" as="geometry"/></mxCell><mxCell id="c57" value="Релиз-инженер НЕДРА + сервис" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="210" y="726" width="170" height="36" as="geometry"/></mxCell><mxCell id="c58" value="Bug «Высокий» → ВНП (блокирующий) → РП (внеплановая). Fix на hotfix/* от ветки Прода; дальше — тот же процесс, что у планового релиза (все этапы и ИБ-gates); после выката — перенос в текущую release." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="380" y="726" width="750" height="36" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;C. Отбор задач в релиз (шаги 0.1 → 1.2)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="470" width="600" height="22" as="geometry"/></mxCell><mxCell id="c60" value="ВКЛЮЧАЕМ, если выполнены ВСЕ условия:&lt;br&gt;• это Story или Bug с fixVersion (Task QA/BE/FE в состав не входят);&lt;br&gt;• есть оценка (задач без оценки в спринте нет);&lt;br&gt;• привязаны тест-кейсы (или исключение RO + QA);&lt;br&gt;• есть кодовый инкремент: PR → ключ Story;&lt;br&gt;• приложены скрипты миграции (БД / конфигурация);&lt;br&gt;• уязвимости по сервису закрыты по ходу спринта;&lt;br&gt;• при ПСИ — ПМТ покрывает изменение." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F3E4;strokeColor=#82B366;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="498" width="320" height="220" as="geometry"/></mxCell><mxCell id="c61" value="НЕ ВКЛЮЧАЕМ, если:&lt;br&gt;• нет тест-кейсов без согласованного исключения;&lt;br&gt;• нет оценки или не прикреплён кодовый инкремент;&lt;br&gt;• нет скриптов миграции там, где они нужны;&lt;br&gt;• зависит от задачи вне Fix Version;&lt;br&gt;• приём после Scope freeze без change control;&lt;br&gt;• нужен ПСИ, но нет ПМТ." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5E1;strokeColor=#C0392B;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1540" y="498" width="320" height="220" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Вопрос&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="740" width="250" height="24" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;Решение&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="740" width="410" height="24" as="geometry"/></mxCell><mxCell id="c64" value="Кто собирает состав релиза" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="764" width="250" height="24" as="geometry"/></mxCell><mxCell id="c65" value="Release owner (Акманов А.) с РП команд" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="764" width="410" height="24" as="geometry"/></mxCell><mxCell id="c66" value="Кто подтверждает техготовность" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="788" width="250" height="36" as="geometry"/></mxCell><mxCell id="c67" value="Мейнтейнеры сервисов (по таблице «Статус развёртывания инфраструктуры ЕАРМ»)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="788" width="410" height="36" as="geometry"/></mxCell><mxCell id="c68" value="Кто принимает по функционалу" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="824" width="250" height="24" as="geometry"/></mxCell><mxCell id="c69" value="ВНП направления (go/no-go по функционалу)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="824" width="410" height="24" as="geometry"/></mxCell><mxCell id="c70" value="Где фиксируется состав" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="848" width="250" height="36" as="geometry"/></mxCell><mxCell id="c71" value="Fix Version в Jira — единственный источник; календарь и паспорт — витрина" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="848" width="410" height="36" as="geometry"/></mxCell><mxCell id="c72" value="Изменение состава после freeze" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="884" width="250" height="24" as="geometry"/></mxCell><mxCell id="c73" value="Только change control: решение RO + причина (код E1) в Jira" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="884" width="410" height="24" as="geometry"/></mxCell><mxCell id="c74" value="Отложенные задачи" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="908" width="250" height="24" as="geometry"/></mxCell><mxCell id="c75" value="Следующий Fix Version сервиса с причиной переноса" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="908" width="410" height="24" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b&gt;Открытый риск F1 — пересечение циклов&lt;/b&gt;&lt;br&gt;Релиз выходит примерно раз в 4 недели, а цикл (T−6 нед … T+2 дн) длиннее: ветка следующего релиза режется в начале спринта, когда предыдущий ещё не в Проде. Правило: ветка N+1 режется от master; после 12.5 релиза N его изменения вливаются в release N+1 (и в master). До утверждения этого правила в эталоне и ДК hotfix и перенос фиксов остаются рисками потери кода." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="1010" width="1100" height="140" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#222222;strokeWidth=3.5;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="60" y="190" as="sourcePoint"/><mxPoint x="1840" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=10;fontColor=#6C8EBF;labelBackgroundColor=#FFFFFF;endArrow=classic;endFill=1;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="60" y="370" as="sourcePoint"/><mxPoint x="560" y="290" as="targetPoint"/><Array as="points"><mxPoint x="500" y="370"/></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#7F7F7F;strokeWidth=2;fontSize=10;fontColor=#7F7F7F;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="60" y="420" as="sourcePoint"/><mxPoint x="480" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#C07000;strokeWidth=3.5;fontSize=10;fontColor=#C07000;labelBackgroundColor=#FFFFFF;endArrow=classic;endFill=1;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="380" y="190" as="sourcePoint"/><mxPoint x="1590" y="190" as="targetPoint"/><Array as="points"><mxPoint x="410" y="290"/><mxPoint x="1560" y="290"/></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#C0392B;strokeWidth=3;fontSize=10;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;endArrow=classic;endFill=1;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1180" y="190" as="sourcePoint"/><mxPoint x="1450" y="190" as="targetPoint"/><Array as="points"><mxPoint x="1210" y="120"/><mxPoint x="1420" y="120"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="3. Матрица сервис × этап" name="3. Матрица сервис × этап"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2194" pageHeight="682" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object label="&lt;b&gt;Релиз-процесс ЕАРМ · Сервис: %service% · Направление: %direction% · Релиз: %version% · Fix Version %version%   |   матрица «сервис × этап»: ответственный · план · факт · результат&lt;/b&gt;" placeholders="1" service="⟨СЕРВИС⟩" direction="⟨ЕАРМ1–6⟩" version="⟨27.x.y⟩" id="title"><mxCell style="text;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=15;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="6" width="2174" height="34" as="geometry"/></mxCell></object><mxCell id="c2" value="Блок строк на сервис. Значения — из задач Jira с ID шага (план — оценка, факт — переходы статусов / списание). SLA — нормативы 1–5 раб. дней (предложение, подтвердить; приём PR 1.1 — по спринту). Результат: ✓ без возврата · ↩ был возврат (код E1–E7) · ✗ нарушено требование · — не применимо. Сервисы — SERVICES в scripts/build_release_process.py (источник: таблица «Статус развёртывания инфраструктуры ЕАРМ»)." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="2154" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Сервис / показатель&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="210" height="28" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Ф0&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1E1E1;strokeColor=#A0A0A0;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="162" height="28" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Ф1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1E1E1;strokeColor=#A0A0A0;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="