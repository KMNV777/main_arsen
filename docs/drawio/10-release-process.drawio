n=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1289" y="279" width="22" height="22" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;7&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=2;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1564" y="179" width="22" height="22" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;8&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=2;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1304" y="109" width="22" height="22" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;B. Что означает каждая отметка (шаг на странице 1 → ответственный → правило)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="900" height="22" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;№&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="498" width="40" height="24" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Шаг&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="498" width="190" height="24" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Отв.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="250" y="498" width="80" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Правило&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="330" y="498" width="840" height="24" as="geometry"/></mxCell><mxCell id="c27" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="522" width="40" height="24" as="geometry"/></mxCell><mxCell id="c28" value="1.1 Создание ветки" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="522" width="190" height="24" as="geometry"/></mxCell><mxCell id="c29" value="DEV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="250" y="522" width="80" height="24" as="geometry"/></mxCell><mxCell id="c30" value="Ветка режется только после фиксации скоупа (0.2) и только от master. SHA master записывается в релиз-тикет. Имя: release/&amp;lt;сервис&amp;gt;/&amp;lt;версия&amp;gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="330" y="522" width="840" height="24" as="geometry"/></mxCell><mxCell id="c31" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="546" width="40" height="36" as="geometry"/></mxCell><mxCell id="c32" value="1.2 Слив задач" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="546" width="190" height="36" as="geometry"/></mxCell><mxCell id="c33" value="DEV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="250" y="546" width="80" height="36" as="geometry"/></mxCell><mxCell id="c34" value="Только задачи из скоупа тикета, каждая отдельным MR в release: ревью ✓, CI ✓, dev-тест ✓. Порядок слива фиксируется; расхождение «скоуп ↔ ветка» = 0 до фриза." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="330" y="546" width="840" height="36" as="geometry"/></mxCell><mxCell id="c35" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="582" width="40" height="36" as="geometry"/></mxCell><mxCell id="c36" value="1.4 Фича-фриз" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="582" width="190" height="36" as="geometry"/></mxCell><mxCell id="c37" value="DEV / RM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="250" y="582" width="80" height="36" as="geometry"/></mxCell><mxCell id="c38" value="После фриза новые задачи не принимаются. Исключение — fix crit/blocker с письменным согласием RM в тикете; такой случай = ошибка E1 (скоуп) для разбора." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="330" y="582" width="840" height="36" as="geometry"/></mxCell><mxCell id="c39" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="618" width="40" height="24" as="geometry"/></mxCell><mxCell id="c40" value="2.3 Устранение критов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="618" width="190" height="24" as="geometry"/></mxCell><mxCell id="c41" value="DEV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="250" y="618" width="80" height="24" as="geometry"/></mxCell><mxCell id="c42" value="Только fix-коммиты по заведённым дефектам и замечаниям ИБ. Каждый коммит ссылается на дефект. После последнего fix фиксируется hash код-фриза." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="330" y="618" width="840" height="24" as="geometry"/></mxCell><mxCell id="c43" value="5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="642" width="40" height="24" as="geometry"/></mxCell><mxCell id="c44" value="3.1 Релиз-борд" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="642" width="190" height="24" as="geometry"/></mxCell><mxCell id="c45" value="DEV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="250" y="642" width="80" height="24" as="geometry"/></mxCell><mxCell id="c46" value="В борд уходит rc-тег на hash код-фриза. Hash, по которому прошли smoke 2.4 и аудит 2.7, обязан совпадать — иначе G1 недействителен." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="330" y="642" width="840" height="24" as="geometry"/></mxCell><mxCell id="c47" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="666" width="40" height="24" as="geometry"/></mxCell><mxCell id="c48" value="4.x / 5.x PreProd → Прод" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="666" width="190" height="24" as="geometry"/></mxCell><mxCell id="c49" value="RM / OPS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="250" y="666" width="80" height="24" as="geometry"/></mxCell><mxCell id="c50" value="Деплой только того hash, что в релиз-борде. Любое изменение кода после G1 = возврат на 2.3 и повтор G1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="330" y="666" width="840" height="24" as="geometry"/></mxCell><mxCell id="c51" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="40" height="24" as="geometry"/></mxCell><mxCell id="c52" value="5.4 Тег и merge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="190" height="24" as="geometry"/></mxCell><mxCell id="c53" value="DEV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="250" y="690" width="80" height="24" as="geometry"/></mxCell><mxCell id="c54" value="После стабильного Прода: тег v&amp;lt;версия&amp;gt;, merge release → master, back-merge в ветки разработки. До этого master не меняется." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="330" y="690" width="840" height="24" as="geometry"/></mxCell><mxCell id="c55" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="714" width="40" height="24" as="geometry"/></mxCell><mxCell id="c56" value="HF Hotfix" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="714" width="190" height="24" as="geometry"/></mxCell><mxCell id="c57" value="DEV / RM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="250" y="714" width="80" height="24" as="geometry"/></mxCell><mxCell id="c58" value="Ветка hotfix/* только от master. После выката — merge в master и в открытые release/*; повтор 2.4 → G1 → 3.1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="330" y="714" width="840" height="24" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;C. Отбор задач в релиз (шаг 0.2)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="470" width="600" height="22" as="geometry"/></mxCell><mxCell id="c60" value="ВКЛЮЧАЕМ, если выполнены ВСЕ условия:&lt;br&gt;• задача привязана к релиз-тикету сервиса;&lt;br&gt;• dev-тест пройден, MR одобрен, CI зелёный;&lt;br&gt;• есть тест-кейсы / описано, что проверять QA;&lt;br&gt;• миграции БД и брокеров имеют откат;&lt;br&gt;• нет зависимости от задач вне скоупа;&lt;br&gt;• при ПСИ — ПМТ покрывает изменение." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F3E4;strokeColor=#82B366;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="498" width="320" height="190" as="geometry"/></mxCell><mxCell id="c61" value="НЕ ВКЛЮЧАЕМ, если:&lt;br&gt;• нет dev-теста или не пройден CI;&lt;br&gt;• зависит от несмерженной / невыпущенной задачи;&lt;br&gt;• миграция без отката или ломает обратную совместимость;&lt;br&gt;• нужен ПСИ, но нет ПМТ;&lt;br&gt;• принята позже фриза без согласия RM;&lt;br&gt;• затрагивает несколько сервисов без согласованного плана выката." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5E1;strokeColor=#C0392B;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1540" y="498" width="320" height="190" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Вопрос&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="710" width="250" height="24" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;Решение&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="710" width="410" height="24" as="geometry"/></mxCell><mxCell id="c64" value="Кто предлагает скоуп" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="734" width="250" height="24" as="geometry"/></mxCell><mxCell id="c65" value="RM (по сервису)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="734" width="410" height="24" as="geometry"/></mxCell><mxCell id="c66" value="Кто подтверждает техническую готовность" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="758" width="250" height="24" as="geometry"/></mxCell><mxCell id="c67" value="DEV — тимлид релиза" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="758" width="410" height="24" as="geometry"/></mxCell><mxCell id="c68" value="Кто оценивает риск и тест-покрытие" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="782" width="250" height="24" as="geometry"/></mxCell><mxCell id="c69" value="QA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="782" width="410" height="24" as="geometry"/></mxCell><mxCell id="c70" value="Где фиксируется скоуп" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="806" width="250" height="36" as="geometry"/></mxCell><mxCell id="c71" value="Релиз-тикет Jira (поле «Скоуп» = связанные задачи); после 0.2 блокируется" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="806" width="410" height="36" as="geometry"/></mxCell><mxCell id="c72" value="Как меняется скоуп после фриза" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="842" width="250" height="24" as="geometry"/></mxCell><mxCell id="c73" value="Только через согласие RM + запись в тикете + код ошибки E1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="842" width="410" height="24" as="geometry"/></mxCell><mxCell id="c74" value="Что с отложенными задачами" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1200" y="866" width="250" height="24" as="geometry"/></mxCell><mxCell id="c75" value="Переносятся в следующий релиз сервиса с причиной переноса" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="866" width="410" height="24" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#222222;strokeWidth=3.5;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" rel