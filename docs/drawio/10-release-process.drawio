tSize=10;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 3;endArrow=classic;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c10"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="95" y="428"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="5. Ревью процессов" name="5. Ревью процессов"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="798" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object label="&lt;b&gt;Релиз-процесс ЕАРМ · Сервис: %service% · Направление: %direction% · Релиз: %version% · Fix Version %version%   |   ревью: расхождения и пробелы между эталоном ЕАРМ, «Менеджментом команд» и прежней схемой&lt;/b&gt;" placeholders="1" service="⟨СЕРВИС⟩" direction="⟨ЕАРМ1–6⟩" version="⟨27.x.y⟩" id="title"><mxCell style="text;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=15;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="6" width="2080" height="34" as="geometry"/></mxCell></object><mxCell id="c2" value="Источники: Confluence «Эталонный процесс выпуска релиза» (Э), презентация «Менеджмент команд разработки» (М), прежняя схема процесса (С). Подробнее — docs/release-process-review.md." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="2060" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;ID&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="40" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Важность&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="70" height="24" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Где&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="100" width="190" height="24" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Находка&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="700" height="24" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Влияние&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="480" height="24" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Что сделано / предложение&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="100" width="580" height="24" as="geometry"/></mxCell><mxCell id="c9" value="F1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="124" width="40" height="50" as="geometry"/></mxCell><mxCell id="c10" value="Высокая" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="124" width="70" height="50" as="geometry"/></mxCell><mxCell id="c11" value="Эталон §2, §13; Приложение 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="124" width="190" height="50" as="geometry"/></mxCell><mxCell id="c12" value="master в эталоне не упоминается; релизная ветка создаётся в начале каждого спринта, hotfix идёт «по предыдущей релизной ветке». Релиз раз в ~4 недели, а цикл T−6 нед → всегда ≥ 2 релиза в работе: ветка N+1 режется до выката N, правила переноса нет." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="124" width="700" height="50" as="geometry"/></mxCell><mxCell id="c13" value="Потеря фиксов при переносе, ветки расходятся, hotfix не попадает в следующий релиз." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="124" width="480" height="50" as="geometry"/></mxCell><mxCell id="c14" value="✔ Решено: ветка режется от master. master = состояние Прода; 12.5: merge release → master и перенос в открытые release; hotfix — от ветки Прода (= master после 12.5)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="124" width="580" height="50" as="geometry"/></mxCell><mxCell id="c15" value="F2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="174" width="40" height="36" as="geometry"/></mxCell><mxCell id="c16" value="Высокая" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="174" width="70" height="36" as="geometry"/></mxCell><mxCell id="c17" value="Эталон §4 (этапы 2, 4, 5, 6–12)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="174" width="190" height="36" as="geometry"/></mxCell><mxCell id="c18" value="Нигде не сказано, что скан (2), регресс (4), аудит (5), ПТЗ (6), трансфер (7–8), PreProd (9) и Prod (12) относятся к одному и тому же коду/образу. Скан идёт до исправлений UAT, аудит — после." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="174" width="700" height="36" as="geometry"/></mxCell><mxCell id="c19" value="В Прод может уйти код, который не сканировали и не аудировали." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="174" width="480" height="36" as="geometry"/></mxCell><mxCell id="c20" value="Шлюз G1 «Код-фриз» фиксирует hash/образ; 5.1, 7.2, 9.1, 12.1 сверяют его; после 4.3 — повторный скан в CI." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="174" width="580" height="36" as="geometry"/></mxCell><mxCell id="c21" value="F3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="40" height="36" as="geometry"/></mxCell><mxCell id="c22" value="Высокая" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="70" height="36" as="geometry"/></mxCell><mxCell id="c23" value="Эталон §5; Менеджмент (Релизный Epic)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="210" width="190" height="36" as="geometry"/></mxCell><mxCell id="c24" value="В Релизном Epic всего 5 работ: «уязвимости и слияние веток» — один Enabler, «регресс PreProd и деплой на прод» — один Task. Время этапов 1/2 и 10/12 неразделимо." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="210" width="700" height="36" as="geometry"/></mxCell><mxCell id="c25" value="Нельзя посчитать время и ошибки по каждому этапу (цель ревью)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="210" width="480" height="36" as="geometry"/></mxCell><mxCell id="c26" value="Задача Jira на каждый шаг реестра (ID шага), под-задача на каждый сервис там, где работа по сервису." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="210" width="580" height="36" as="geometry"/></mxCell><mxCell id="c27" value="F4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="246" width="40" height="36" as="geometry"/></mxCell><mxCell id="c28" value="Высокая" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="246" width="70" height="36" as="geometry"/></mxCell><mxCell id="c29" value="Менеджмент (сущности Jira); Эталон §14.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="246" width="190" height="36" as="geometry"/></mxCell><mxCell id="c30" value="Исполнение ведут мейнтейнеры сервисов, но в Jira нет сущности «Сервис» на релизных работах: Epic — на команду/квартал, Component — бизнес-функциональность." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="246" width="700" height="36" as="geometry"/></mxCell><mxCell id="c31" value="Нельзя оценить качество прохождения этапов по каждому сервису." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="246" width="480" height="36" as="geometry"/></mxCell><mxCell id="c32" value="Поле «Сервис» (список из таблицы «Статус развёртывания инфраструктуры ЕАРМ») на каждой релизной под-задаче; матрица «сервис × этап» (стр. 3)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="246" width="580" height="36" as="geometry"/></mxCell><mxCell id="c33" value="F5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="282" width="40" height="36" as="geometry"/></mxCell><mxCell id="c34" value="Высокая" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="282" width="70" height="36" as="geometry"/></mxCell><mxCell id="c35" value="Эталон §8 «Причина сдвига и риск»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="282" width="190" height="36" as="geometry"/></mxCell><mxCell id="c36" value="5 категорий ([Качество], [Согласование], [ПСИ], [Инфра], [Зависимость]) ставятся на уровне релиза, без шага, сервиса и исполнителя. Нет категорий для ошибок скоупа и оценки, нарушений регламента, внесения дефекта." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="282" width="700" height="36" as="geometry"/></mxCell><mxCell id="c37" value="Нельзя ответить, где, кем и на каком шаге допущена ошибка и где систематически ошибаемся в оценке." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="282" width="480" height="36" as="geometry"/></mxCell><mxCell id="c38" value="Две оси: категория календаря (как есть) + код E1–E7 на каждом возврате; в карточке — этап внесения и этап обнаружения." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="282" width="580" height="36" as="geometry"/></mxCell><mxCell id="c39" value="F6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="318" width="40" height="50" as="geometry"/></mxCell><mxCell id="c40" value="Высокая" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="318" width="70" height="50" as="geometry"/></mxCell><mxCell id="c41" value="Эталон §16 (RACI) vs §14.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="318" width="190" height="50" as="geometry"/></mxCell><mxCell id="c42" value="Этап 3: два A (ИБ и ВНП) — нарушено собственное правило «один A». Этап 12: A = Сервис, Release owner = I, а §14.1 ставит деплой на Release owner + релиз-инженера. Этапы 1–2: R = DevOps/РП, а §14.1 — мейнтейнеры (роли «Мейнтейнер» в RACI нет). Этап 4: A = РП, отчёт — у подрядчика." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="318" width="700" height="50" as="geometry"/></mxCell><mxCell id="c43" value="Не ясно, кто отвечает за результат этапа; спор «чей это шаг» срывает сроки." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="318" width="480" height="50" as="geometry"/></mxCell><mxCell id="c44" value="ЗО шагов взяты из §14.1; в RACI предлагается добавить роли «Мейнтейнер» и «Релиз-инженер», по одному A на этап (ПСИ: A = ВНП, ИБ — gate 3b)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="318" width="580" height="50" as="geometry"/></mxCell><mxCell id="c45" value="F7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="368" width="40" height="36" as="geometry"/></mxCell><mxCell id="c46" value="Средняя" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="368" width="70" height="36" as="geometry"/></mxCell><mxCell id="c47" value="Прежняя схема (BPMN) vs Эталон §4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="368" width="190" height="36" as="geometry"/></mxCell><mxCell id="c48" value="ПТЗ: на схеме «при необходимости», в эталоне — обязательный gate (6), без него трансфер не стартует." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="368" width="700" height="36" as="geometry"/></mxCell><mxCell id="c49" value="Разный критический путь; можно ждать согласование, которое не нужно (или пропустить обязательное)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="368" width="480" height="36" as="geometry"/></mxCell><mxCell id="c50" value="✔ Решено: ПТЗ «при необходимости». Шаг 6.1 опциональный; флаг «Требуется ПТЗ» на 0.3 ставит релиз-инженер НЕДРА. Эталон §4 нужно поправить." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="368" width="580" height="36" as="geometry"/></mxCell><mxCell id="c51" value="F8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="404" width="40" height="36" as="geometry"/></mxCell><mxCell id="c52" value="Средняя" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="404" width="70" height="36" as="geometry"/></mxCell><mxCell id="c53" value="Прежняя схема vs Эталон §4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="404" width="190" height="36" as="geometry"/></mxCell><mxCell id="c54" value="ПСИ на прежней схеме целиком на стороне ИБ. По эталону: ПМТ готовит разработка (3a), ИБ только согласует (3b), ПСИ проводят QA + бизнес (3c, gate бизнес)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="404" width="700" height="36" as="geometry"/></mxCell><mxCell id="c55" value="Ложная ЗО: время бизнеса/QA записывалось бы на ИБ." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="404" width="480" height="36" as="geometry"/></mxCell><mxCell id="c56" value="Исправлено: ПСИ — трек C с тремя шагами и своими ЗО." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="404" width="580" height="36" as="geometry"/></mxCell><mxCell id="c57" value="F9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="40" height="24" as="geometry"/></mxCell><mxCell id="c58" value="Средняя" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="70" height="24" as="geometry"/></mxCell><mxCell id="c59" value="Эталон §4 vs §13 (таблица B)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="440" width="190" height="24" as="geometry"/></mxCell><mxCell id="c60" value="§4 ставит этапы последовательно (1 → 2 → 4 → 5), таблица B перекрывает их (4 и 5 — оба T−10…7 дн; 2 и 3 — оба T−2 нед)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="440" width="700" height="24" as="geometry"/></mxCell><mxCell id="c61" value="Неясно, что можно делать параллельно; критический путь не определён." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="440" width="480" height="24" as="geometry"/></mxCell><mxCell id="c62" value="Явный параллельный блок P (треки A QA, B уязвимости, C ПСИ) со стыком на G1; аудит — строго после G1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="440" width="580" height="24" as="geometry"/></mxCell><mxCell id="c63" value="F10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="464" width="40" height="36" as="geometry"/></mxCell><mxCell id="c64" value="Средняя" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="464" width="70" height="36" as="geometry"/></mxCell><mxCell id="c65" value="Эталон §1, §10, §2; Менеджмент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="464" width="190" height="36" as="geometry"/></mxCell><mxCell id="c66" value="Ритм назван по-разному: «до трёх релизов в квартал», «плановый месячный», страница «2-недельные релизы», спринты по 2 недели." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="464" width="700" height="36" as="geometry"/></mxCell><mxCell id="c67" value="Разные ожидания по длительности цикла и срокам этапов." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="464" width="480" height="36" as="geometry"/></mxCell><mxCell id="c68" value="Нужно утвердить ритм; в схеме цикл показан как один релиз, пересечение циклов — в F1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="464" width="580" height="36" as="geometry"/></mxCell><mxCell id="c69" value="F11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="40" height="50" as="geometry"/></mxCell><mxCell id="c70" value="Средняя" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="70" height="50" as="geometry"/></mxCell><mxCell id="c71" value="Прежняя схема vs Эталон §4, §14.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="500" width="190" height="50" as="geometry"/></mxCell><mxCell id="c72" value="На схеме нет: Gate по уязвимостям (2), TOML, трансфера (7–8), уведомления (11), импорта тест-плана в ТестОпс ГПН-ЦР. Есть то, чего нет в эталоне: «БД и брокеры». «Загрузка в релиз-борд» у Юрченко Д., а в эталоне запуск аудита через Релиз-борд — у Приходько В. Юрченко Д. нет ни в §14, ни в §15." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="500" width="700" height="50" as="geometry"/></mxCell><mxCell id="c73" value="Часть реальных шагов и ЗО невидима → нет данных по ним." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="500" width="480" height="50" as="geometry"/></mxCell><mxCell id="c74" value="✔ Решено: Юрченко Д. — релиз-инженер НЕДРА; БД — администратор БД; брокеры — администратор брокеров (шаги 9.2/9.3, 12.2/12.3 разделены). Все шаги эталона добавлены; в эталон и ДК нужно внести роли." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="500" width="580" height="50" as="geometry"/></mxCell><mxCell id="c75" value="F12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="40" height="36" as="geometry"/></mxCell><mxCell id="c76" value="Средняя" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="70" height="36" as="geometry"/></mxCell><mxCell id="c77" value="Эталон §4 (этапы 0, 1), §2 п. 4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="550" width="190" height="36" as="geometry"/></mxCell><mxCell id="c78" value="Scope freeze — этап 0, слияние PR — этап 1, а ветка создаётся в начале спринта. Порядок «заморозили состав → влили» противоречит «ветка живёт весь спринт»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="550" width="700" height="36" as="geometry"/></mxCell><mxCell id="c79" value="Задачи вливаются после «заморозки» либо заморозка не работает." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="550" width="480" height="36" as="geometry"/></mxCell><mxCell id="c80" value="Принято: ветка — в начале спринта (0.2), приём PR (1.1), затем Scope freeze (1.2); после него — только change control." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="550" width="580" height="36" as="geometry"/></mxCell><mxCell id="c81" value="F13" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="586" width="40" height="36" as="geometry"/></mxCell><mxCell id="c82" value="Средняя" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="586" width="70" height="36" as="geometry"/></mxCell><mxCell id="c83" value="Эталон §10 (hotfix)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="586" width="190" height="36" as="geometry"/></mxCell><mxCell id="c84" value="Паспорт hotfix — этапы 1–2, 9–12; аудит, ПТЗ и согласование трансфера (5–8) пропущены, хотя образ всё равно переносится в ПРОД-сегмент." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="586" width="700" height="36" as="geometry"/></mxCell><mxCell id="c85" value="Либо обход ИБ-gates, либо недокументированное исключение." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="586" width="480" height="36" as="geometry"/></mxCell><mxCell id="c86" value="✔ Решено: hotfix идёт тем же процессом (этапы 0–12, все ИБ-gates). На схеме — цикл по hotfix/* с входом в параллельный блок. Эталон §10 («короткий паспорт») нужно поправить." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="586" width="580" height="36" as="geometry"/></mxCell><mxCell id="c87" value="F14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="622" width="40" height="36" as="geometry"/></mxCell><mxCell id="c88" value="Средняя" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="622" width="70" height="36" as="geometry"/></mxCell><mxCell id="c89" value="Эталон §6; Менеджмент (дорожная карта)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="622" width="190" height="36" as="geometry"/></mxCell><mxCell id="c90" value="Календарь и паспорт ведутся вручную (≥ раз в неделю); списание времени в Jira — только этап 3 дорожной карты (I кв. 2027). Метрик времени/ожидания в эталоне нет — только светофор план/прогноз/факт." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="622" width="700" height="36" as="geometry"/></mxCell><mxCell id="c91" value="Данные для метрик из Confluence недостоверны; факта по этапам пока нет." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="622" width="480" height="36" as="geometry"/></mxCell><mxCell id="c92" value="Источник метрик — Jira (переходы статусов и оценки); worklog — когда внедрят списание. Календарь — витрина, не источник." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="622" width="580" height="36" as="geometry"/></mxCell><mxCell id="c93" value="F15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="658" width="40" height="36" as="geometry"/></mxCell><mxCell id="c94" value="Низкая" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F3E4;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="658" width="70" height="36" as="geometry"/></mxCell><mxCell id="c95" value="Эталон §4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="658" width="190" height="36" as="geometry"/></mxCell><mxCell id="c96" value="Нет явных шагов после выката: merge в master, перенос в ветки, закрытие релиза, ретро; нет шага повторной проверки после исправлений UAT." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="658" width="700" height="36" as="geometry"/></mxCell><mxCell id="c97" value="Расхождение веток и потеря знаний между релизами." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="658" width="480" height="36" as="geometry"/></mxCell><mxCell id="c98" value="Добавлены 4.4, 12.5, 12.6 (mark «new»)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="658" width="580" height="36" as="geometry"/></mxCell><mxCell id="c99" value="F17" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="694" width="40" height="50" as="geometry"/></mxCell><mxCell id="c100" value="Высокая" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="694" width="70" height="50" as="geometry"/></mxCell><mxCell id="c101" value="SLA 1–5 дн (решение владельца) vs Эталон §13 (таблица B)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="694" width="190" height="50" as="geometry"/></mxCell><mxCell id="c102" value="Если каждый шаг использует свой потолок SLA (1–5 дн), путь от rc до закрытия — 35–38 рабочих дней (≈ 7–7,6 нед.), тогда как календарь эталона закладывает ≈ 15 рабочих дней (T−3 нед → T). Цепочка ИБ-gates 5.1–8.1 по SLA — 10–13 дней, в календаре — 7 (T−10…T−3 дн)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="694" width="700" height="50" as="geometry"/></mxCell><mxCell id="c103" value="Релиз либо систематически «сдвигается», либо SLA — только потолок, а не норма: без этого M9 и светофор календаря будут расходиться." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="694" width="480" height="50" as="geometry"/></mxCell><mxCell id="c104" value="SLA в схеме — потолок на шаг; нужно утвердить целевые значения (медианы) и пересобрать календарь по критическому пути (стр. 4, блок E)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="694" width="580" height="50" as="geometry"/></mxCell><mxCell id="c105" value="F16" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="744" width="40" height="24" as="geometry"/></mxCell><mxCell id="c106" value="Низкая" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F3E4;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="744" width="70" height="24" as="geometry"/></mxCell><mxCell id="c107" value="Эталон §18, §17" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="130" y="744" width="190" height="24" as="geometry"/></mxCell><mxCell id="c108" value="Блокеры по доступам уже сопоставлены с этапами, но в метриках не учитываются." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="744" width="700" height="24" as="geometry"/></mxCell><mxCell id="c109" value="«Ждём доступ» растворяется в общем ожидании." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="744" width="480" height="24" as="geometry"/></mxCell><mxCell id="c110" value="«Нет доступа» — подкод E5/E6 с привязкой к этапу (из §18)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="744" width="580" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
