из-борд (контур ГПН)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#FFFFFF;strokeWidth=1;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="2507" y="46" width="1140" height="40" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;PreProd&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#FFFFFF;strokeWidth=1;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="3647" y="46" width="870" height="40" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Прод и закрытие&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#FFFFFF;strokeWidth=1;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="4517" y="46" width="1273" height="40" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CFF85E;strokeColor=#8AB800;strokeWidth=1.2;fillOpacity=14;dashed=1;dashPattern=6 3;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="966" y="86" width="858" height="1530" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;СПРИНТ: параллельно разработка · скан в CI · тестирование · release notes → демо → вывод не принятых → фича-фриз (тег)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#4F6600;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="972" y="88" width="900" height="16" as="geometry"/></mxCell><mxCell id="c31" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDAB64;strokeColor=#FF7500;strokeWidth=1.5;fillOpacity=18;dashed=1;dashPattern=6 3;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1830" y="216" width="247" height="820" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;ПАРАЛЛЕЛЬНО ДРУГ ДРУГУ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#B85500;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1836" y="218" width="300" height="16" as="geometry"/></mxCell><mxCell id="c33" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF7500;strokeWidth=2;dashed=1;dashPattern=6 3;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="2511" y="806" width="1133" height="480" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;РЕЛИЗ-БОРД В ПОРЯДКЕ БОРДА · НЕДРА только инициирует (запуск и документ для ПСИ), шаги выполняет контур ГПН&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#B85500;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="2517" y="1266" width="1100" height="16" as="geometry"/></mxCell><mxCell id="c35" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDAB64;strokeColor=#FF7500;strokeWidth=1.5;fillOpacity=18;dashed=1;dashPattern=6 3;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="3840" y="1166" width="247" height="320" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;ПАРАЛЛЕЛЬНО&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#B85500;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="3846" y="1168" width="200" height="16" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDAB64;strokeColor=#FF7500;strokeWidth=1.5;fillOpacity=18;dashed=1;dashPattern=6 3;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="4900" y="1166" width="247" height="450" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;ПАРАЛЛЕЛЬНО&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#B85500;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="4906" y="1168" width="200" height="16" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1  Приоритеты бэклога&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: ВНП&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Приоритеты бэклога
Ответственный: Владелец направления (ВНП)
Исполнители: Владелец направления (ВНП)
ВНП направления сообщает приоритеты бэклога и бизнес-требований на спринт."><mxGeometry x="215" y="107" width="155" height="88" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2  Оценка задач и планирование спринта&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: РП&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: мейнтейнеры, QA · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Оценка задач и планирование спринта
Ответственный: Руководитель проекта (РП) направления
Исполнители: Руководитель проекта (РП) направления, Мейнтейнеры сервисов / фича-команды, Lead QA / QA команд
РП направления вместе с командой оценивает задачи и формирует состав спринта с учётом ёмкости ролей. Ёмкость QA считается за вычетом резерва на регресс и Smoke предыдущего релиза (см. «Стратегическое планирование»)."><mxGeometry x="405" y="342" width="155" height="88" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3  Сбор релизного тикета&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: РП · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Сбор релизного тикета
Ответственный: Release owner
Исполнители: Release owner, Руководитель проекта (РП) направления
Release owner собирает релизный тикет (Fix Version) из оценённых задач: только Story и Bug с оценкой, тест-кейсами и скриптами миграции; заводит строку в календаре и паспорт релиза."><mxGeometry x="595" y="234" width="155" height="88" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4  Подтверждение состава релиза&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: ВНП&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Подтверждение состава релиза
Ответственный: Владелец направления (ВНП)
Исполнители: Владелец направления (ВНП)
ВНП направления подтверждает состав релизного тикета: что должно войти в релиз. После подтверждения стартует спринт."><mxGeometry x="785" y="107" width="155" height="88" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5  Разработка и влитие задач в master&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: мейнтейнеры&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA спринт&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Разработка и влитие задач в master
Ответственный: Мейнтейнеры сервисов / фича-команды
Исполнители: Мейнтейнеры сервисов / фича-команды
Мейнтейнеры вливают закрытые задачи в master своего сервиса (у каждого сервиса свой репозиторий): PR с ревью, ссылкой на ключ Story, кодовым инкрементом и скриптами миграции. Незавершённое — за feature flag; сложные фичи — в опциональную агрегирующую (супер-фича) ветку, которая вливается в master целиком после приёмки."><mxGeometry x="1030" y="594" width="155" height="88" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6  Скан и устранение уязвимостей в CI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: мейнтейнеры&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA спринт&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Скан и устранение уязвимостей в CI
Ответственный: Мейнтейнеры сервисов / фича-команды
Исполнители: Мейнтейнеры сервисов / фича-команды
SAST, SCA, Luntry и проверка секретов запускаются в CI на каждый PR; blocker и critical устраняются в спринте — это условие готовности задачи (Релизная политика, правило 6)."><mxGeometry x="1030" y="702" width="155" height="88" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;7  Тестирование задач и исправление багов спринта&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: QA&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: мейнтейнеры · SLA спринт&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Тестирование задач и исправление багов спринта
Ответственный: Lead QA / QA команд
Исполнители: Lead QA / QA команд, Мейнтейнеры сервисов / фича-команды
QA тестирует влитые задачи на UAT по ходу спринта, найденные баги правятся в этом же спринте; задачи без тест-кейсов в релиз не попадают."><mxGeometry x="1030" y="467" width="155" height="88" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;8  Release notes и changelog&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: РП&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: техписатель · SLA спринт&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Release notes и changelog
Ответственный: Руководитель проекта (РП) направления
Исполнители: Технический писатель, Руководитель проекта (РП) направления
Технический писатель по закрытым задачам готовит release notes и changelog к фича-фризу: к моменту подготовки TOML они уже должны быть готовы."><mxGeometry x="1030" y="342" width="155" height="88" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;9  Демо и приёмка задач&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: ВНП&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: QA · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Демо и приёмка задач
Ответственный: Владелец направления (ВНП)
Исполнители: Lead QA / QA команд
QA проводит демо закрытых задач, ВНП принимает их."><mxGeometry x="1275" y="107" width="155" height="88" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b&gt;10  Вывод не принятых задач из релиза&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: РП&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: мейнтейнеры · SLA в день демо&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Вывод не принятых задач из релиза
Ответственный: Руководитель проекта (РП) направления
Исполнители: Руководитель проекта (РП) направления, Мейнтейнеры сервисов / фича-команды
Если задачу не приняли на демо, её убирают из релиза до тега: revert PR либо отключение feature flag, супер-фича-ветка не вливается. Fix Version снимается, задача переносится в следующий релиз."><mxGeometry x="1465" y="342" width="155" height="88" as="geometry"/></mxCell><mxCell id="s11" value="&lt;b&gt;11  Фича-фриз и тег релиза&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: мейнтейнеры · SLA посл. день&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Фича-фриз и тег релиза
Ответственный: Релиз-инженер НЕДРА
Исполнители: Релиз-инженер НЕДРА, Мейнтейнеры сервисов / фича-команды
В последний день спринта новые фичи в релиз не принимаются; на коммит master в репозитории каждого сервиса ставится защищённый (protected) git-тег с ID релиза (например, EARM26.4.1). Всё, что не успели, — в следующий релиз = следующий спринт."><mxGeometry x="1655" y="824" width="155" height="88" as="geometry"/></mxCell><mxCell id="s12" value="&lt;b&gt;12  Регресс на UAT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: QA&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 7 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Регресс на UAT
Ответственный: Lead QA / QA команд
Исполнители: Lead QA / QA команд
Регрессионное тестирование тега релиза по тест-плану из ТестОпс НЕДРА с приоритетом по риску (миграции БД, брокеры, интеграции между сервисами, критичные потоки), контрактные проверки между сервисами, заведение дефектов с критичностью, отчёт о регрессе."><mxGeometry x="1900" y="467" width="155" height="88" as="geometry"/></mxCell><mxCell id="s13" value="&lt;b&gt;13  Финальный скан по тегу релиза (CI)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 3 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Финальный скан по тегу релиза (CI)
Ответственный: Релиз-инженер НЕДРА
Исполнители: Релиз-инженер НЕДРА
Контрольный прогон SAST, SCA, Luntry и секретов по тегу релиза. Основная работа с уязвимостями идёт в спринте; здесь проверяется, что блокеров не осталось."><mxGeometry x="1900" y="932" width="155" height="88" as="geometry"/></mxCell><mxCell id="s14" value="&lt;b&gt;14  Подготовка TOML&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: архитектор · SLA 2 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Подготовка TOML
Ответственный: Release owner
Исполнители: Release owner, Архитектор (ревью TOML)
Release owner готовит TOML-файл релиза: ссылки на готовые release notes и changelog, digest образов, порядок выката и совместимость версий сервисов, обязательный план отката (включая миграции БД); архитектор проводит ревью. TOML нужен для инициации релиз-борда."><mxGeometry x="1900" y="234" width="155" height="88" as="geometry"/></mxCell><mxCell id="s15" value="&lt;b&gt;15  Импорт тест-плана в ТестОпс ГПН-ЦР&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: QA · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Импорт тест-плана в ТестОпс ГПН-ЦР
Ответственный: Release owner
Исполнители: Release owner, Lead QA / QA команд
QA финализирует тест-план, Release owner импортирует его в ТестОпс ГПН-ЦР для регресса на PreProd."><mxGeometry x="1900" y="342" width="155" height="88" as="geometry"/></mxCell><mxCell id="s16" value="&lt;b&gt;16  Устранение багов и уязвимостей после регресса&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: мейнтейнеры&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 7 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Устранение багов и уязвимостей после регресса
Ответственный: Мейнтейнеры сервисов / фича-команды
Исполнители: Мейнтейнеры сервисов / фича-команды
Мейнтейнеры исправляют дефекты регресса и блокирующие находки финального скана: в master, а если в master уже есть изменения следующего спринта — в короткоживущую ветку от тега релиза. Ставится итоговый защищённый тег — код-фриз. Распределение багов по разработчикам — РП направления."><mxGeometry x="2145" y="594" width="155" height="88" as="geometry"/></mxCell><mxCell id="s17" value="&lt;b&gt;17  Smoke UAT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: QA&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 2 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Smoke UAT
Ответственный: Lead QA / QA команд
Исполнители: Lead QA / QA команд
QA проверяет работоспособность итогового тега на UAT; готовность сборки — рекомендация QA."><mxGeometry x="2335" y="467" width="155" height="88" as="geometry"/></mxCell><mxCell id="s18" value="&lt;b&gt;18  Инициация релиз-борда&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Инициация релиз-борда
Ответственный: Релиз-инженер НЕДРА
Исполнители: Релиз-инженер НЕДРА
Релиз-инженер НЕДРА загружает релиз (TOML, теги сервисов) в релиз-борд и запускает его. Далее шаги выполняются автоматически и в контуре ГПН; НЕДРА отвечает только за инициацию."><mxGeometry x="2525" y="824" width="155" height="88" as="geometry"/></mxCell><mxCell id="s19" value="&lt;b&gt;19  Аудит кода&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: ИБ ГПН&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: релиз-борд · SLA 5 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#019390;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Аудит кода
Ответственный: ИБ ГПН (AppSec, Compliance)
Исполнители: ИБ ГПН (AppSec, Compliance), релиз-борд (автоматически)
Первый шаг релиз-борда: аудит кода по зафиксированному тегу; проводит ИБ ГПН. Замечания возвращаются в устранение."><mxGeometry x="2715" y="1057" width="155" height="88" as="geometry"/></mxCell><mxCell id="s20" value="&lt;b&gt;20  Выкатка на UAT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: DevOps ГПН&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: релиз-борд · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Выкатка на UAT
Ответственный: DevOps / инфра ГПН
Исполнители: релиз-борд (автоматически)
Шаг релиз-борда: автоматическая выкатка релиза на UAT."><mxGeometry x="2905" y="1184" width="155" height="88" as="geometry"/></mxCell><mxCell id="s21" value="&lt;b&gt;21  Функциональное тестирование&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: DevOps ГПН&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: релиз-борд · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Функциональное тестирование
Ответственный: DevOps / инфра ГПН
Исполнители: релиз-борд (автоматически)
Шаг релиз-борда: автоматическое функциональное тестирование выкаченного релиза."><mxGeometry x="3095" y="1184" width="155" height="88" as="geometry"/></mxCell><mxCell id="s22" value="&lt;b&gt;22  Решение «Нужен ли ПСИ ИБ» и ПСИ ИБ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: ИБ ГПН&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: релиз-инженер НЕДРА · SLA 0 дн (не нужен) / до 5 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#019390;strokeWidth=1.3;dashed=1;dashPattern=6 3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Решение «Нужен ли ПСИ ИБ» и ПСИ ИБ
Ответственный: ИБ ГПН (AppSec, Compliance)
Исполнители: ИБ ГПН (AppSec, Compliance), Релиз-инженер НЕДРА
Шаг релиз-борда: если ПСИ ИБ не нужен — шаг пропускается сразу; если нужен — релиз-инженер НЕДРА загружает документ, ИБ ГПН проводит ПСИ (до 5 дней)."><mxGeometry x="3285" y="1057" width="155" height="88" as="geometry"/></mxCell><mxCell id="s23" value="&lt;b&gt;23  Согласование трансфера на ПРОД&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: ИБ ГПН&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 5 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#019390;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Согласование трансфера на ПРОД
Ответственный: ИБ ГПН (AppSec, Compliance)
Исполнители: ИБ ГПН (AppSec, Compliance)
Последний шаг релиз-борда: ИБ ГПН согласует перенос образов в Прод; проверяется, что digest образов совпадает с аудированным и указанным в TOML."><mxGeometry x="3475" y="1057" width="155" height="88" as="geometry"/></mxCell><mxCell id="s24" value="&lt;b&gt;24  Уведомление ГПН о начале работ на PreProd&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Уведомление ГПН о начале работ на PreProd
Ответственный: Релиз-инженер НЕДРА
Исполнители: Релиз-инженер НЕДРА
Релиз-инженер НЕДРА уведомляет ГПН, что трансфер согласован и нужно начинать работы на PreProd. Дальнейшие шаги — в зоне ответственности ГПН."><mxGeometry x="3665" y="824" width="155" height="88" as="geometry"/></mxCell><mxCell id="s25" value="&lt;b&gt;25  Выкатка на PreProd&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: DevOps ГПН&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Выкатка на PreProd
Ответственный: DevOps / инфра ГПН
Исполнители: DevOps / инфра ГПН
DevOps ГПН выкатывает релиз на PreProd."><mxGeometry x="3910" y="1184" width="155" height="88" as="geometry"/></mxCell><mxCell id="s26" value="&lt;b&gt;26  БД PreProd: миграции&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: админ БД&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="БД PreProd: миграции
Ответственный: Администратор БД
Исполнители: Администратор БД
Администратор БД ГПН применяет скрипты миграции на PreProd."><mxGeometry x="3910" y="1292" width="155" height="88" as="geometry"/></mxCell><mxCell id="s27" value="&lt;b&gt;27  Брокеры PreProd: топики и настройки&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: админ брокеров&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Брокеры PreProd: топики и настройки
Ответственный: Администратор брокеров
Исполнители: Администратор брокеров
Администратор брокеров ГПН применяет топики и настройки на PreProd."><mxGeometry x="3910" y="1400" width="155" height="88" as="geometry"/></mxCell><mxCell id="s28" value="&lt;b&gt;28  Регресс на PreProd&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: тестировщик ГПН-ЦР&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 3 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Регресс на PreProd
Ответственный: Тестировщик сервиса ГПН-ЦР
Исполнители: Тестировщик сервиса ГПН-ЦР
Тестировщик сервиса ГПН-ЦР проводит регресс на PreProd по тест-плану из ТестОпс ГПН-ЦР."><mxGeometry x="4155" y="1507" width="155" height="88" as="geometry"/></mxCell><mxCell id="s29" value="&lt;b&gt;29  Отчёт о регрессе PreProd&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: тестировщик ГПН-ЦР&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Отчёт о регрессе PreProd
Ответственный: Тестировщик сервиса ГПН-ЦР
Исполнители: Тестировщик сервиса ГПН-ЦР
Тестировщик сервиса ГПН-ЦР фиксирует результат регресса и проверку отката. Релиз идёт в Прод всегда: открытый Blocker релиз не останавливает, а заводится в hotfix. Правки — только на уровне helm, остальные критические дефекты — в hotfix."><mxGeometry x="4345" y="1507" width="155" height="88" as="geometry"/></mxCell><mxCell id="s30" value="&lt;b&gt;30  Организация уведомления пользователей&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: PMM · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Организация уведомления пользователей
Ответственный: Release owner
Исполнители: Release owner, PMM / коммуникации
Release notes и changelog уже готовы (они нужны к TOML). Здесь только организуется рассылка: кому, когда, по какому каналу."><mxGeometry x="4535" y="234" width="155" height="88" as="geometry"/></mxCell><mxCell id="s31" value="&lt;b&gt;31  Деплой в Прод&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер ГПН&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Деплой в Прод
Ответственный: Релиз-инженер ГПН (деплой в Прод)
Исполнители: Релиз-инженер ГПН (деплой в Прод)
Релиз-инженер ГПН выкатывает релиз в Прод по TOML. Release owner НЕДРА инициирует выкат и получает подтверждение."><mxGeometry x="4725" y="1184" width="155" height="88" as="geometry"/></mxCell><mxCell id="s32" value="&lt;b&gt;32  Smoke PROD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: тестировщик ГПН-ЦР&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Smoke PROD
Ответственный: Тестировщик сервиса ГПН-ЦР
Исполнители: Тестировщик сервиса ГПН-ЦР
Тестировщик сервиса ГПН-ЦР проверяет работоспособность в Проде; затем действует окно наблюдения (по мониторингу): при превышении порога ошибок — откат по плану из TOML."><mxGeometry x="4970" y="1507" width="155" height="88" as="geometry"/></mxCell><mxCell id="s33" value="&lt;b&gt;33  БД: пост-миграции&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: админ БД&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="БД: пост-миграции
Ответственный: Администратор БД
Исполнители: Администратор БД
Администратор БД ГПН применяет пост-миграции в Проде."><mxGeometry x="4970" y="1292" width="155" height="88" as="geometry"/></mxCell><mxCell id="s34" value="&lt;b&gt;34  Брокеры: настройки в Проде&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: админ брокеров&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Брокеры: настройки в Проде
Ответственный: Администратор брокеров
Исполнители: Администратор брокеров
Администратор брокеров ГПН применяет настройки брокеров в Проде."><mxGeometry x="4970" y="1400" width="155" height="88" as="geometry"/></mxCell><mxCell id="s35" value="&lt;b&gt;35  Коммуникация ВНП с пользователями&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: ВНП&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: PMM · SLA 2 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Коммуникация ВНП с пользователями
Ответственный: Владелец направления (ВНП)
Исполнители: Владелец направления (ВНП), PMM / коммуникации
После выката в Прод ВНП общается с пользователями: сообщает результат релиза, собирает обратную связь."><mxGeometry x="5215" y="107" width="155" height="88" as="geometry"/></mxCell><mxCell id="s36" value="&lt;b&gt;36  Закрытие релиза и ретро&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: скрам-мастер, админ проекта · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Закрытие релиза и ретро
Ответственный: Release owner
Исполнители: Release owner, Скрам-мастер направления, Администратор проекта (ИСУП, 1С УПП, Jira)
Release owner закрывает релиз и календарь; скрам-мастер проводит ретро (для hotfix, отката или инцидента — безвиновный постмортем в течение 5 рабочих дней); администратор проекта переносит ТРЗ задач этапов в ИСУП и 1С УПП."><mxGeometry x="5405" y="234" width="155" height="88" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="171" y="137" width="28" height="28" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="5600" y="264" width="28" height="28" as="geometry"/></mxCell><mxCell id="F0" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="980" y="131" width="8" height="635" as="geometry"/></mxCell><mxCell id="J0" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1225" y="131" width="8" height="635" as="geometry"/></mxCell><mxCell id="F1" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1850" y="258" width="8" height="738" as="geometry"/></mxCell><mxCell id="J1" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="2095" y="491" width="8" height="505" as="geometry"/></mxCell><mxCell id="F2" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="3860" y="848" width="8" height="616" as="geometry"/></mxCell><mxCell id="J2" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="4105" y="1208" width="8" height="363" as="geometry"/></mxCell><mxCell id="F3" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="4920" y="1208" width="8" height="363" as="geometry"/></mxCell><mxCell id="J3" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="5165" y="131" width="8" height="1440" as="geometry"/></mxCell><mxCell id="c85" value="&lt;b&gt;Hotfix: тот же процесс&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;Blocker и критические дефекты PreProd → hotfix; релиз всё равно идёт в Прод&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFD2A6;strokeColor=#FF7500;strokeWidth=1.5;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="4345" y="932" width="160" height="88" as="geometry"/></mxCell><mxCell id="c99" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A0A0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="0" y="1622" width="5790" height="220" as="geometry"/></mxCell><mxCell id="c100" value="&lt;b&gt;Как читать схему&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#140093;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="1634" width="300" height="18" as="geometry"/></mxCell><mxCell id="c101" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.4;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="1654" width="34" height="20" as="geometry"/></mxCell><mxCell id="c102" value="этап: в дорожке — ответственный (роль компании, где идёт этап); в подписи — исполнители и SLA" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="52" y="1656" width="620" height="18" as="geometry"/></mxCell><mxCell id="c103" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.4;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="1682" width="34" height="20" as="geometry"/></mxCell><mxCell id="c104" value="параллельные этапы (между чёрными планками)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="52" y="1684" width="620" height="18" as="geometry"/></mxCell><mxCell id="c105" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#140093;strokeWidth=1.4;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="1710" width="34" height="20" as="geometry"/></mxCell><mxCell id="c106" value="шаг релиз-борда" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="52" y="1712" width="620" height="18" as="geometry"/></mxCell><mxCell id="c107" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.4;dashed=1;dashPattern=6 3;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="1738" width="34" height="20" as="geometry"/></mxCell><mxCell id="c108" value="шаг, который пропускается, если не нужен (ПСИ ИБ)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="52" y="1740" width="620" height="18" as="geometry"/></mxCell><mxCell id="c110" value="возврат на доработку" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="808" y="1654" width="560" height="18" as="geometry"/></mxCell><mxCell id="c112" value="зависимость (нужно к началу следующего этапа)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="808" y="1682" width="560" height="18" as="geometry"/></mxCell><mxCell id="c113" value="&lt;b&gt;Основные правила&lt;/b&gt;&lt;br&gt;• Нумерация этапов сквозная, 1–36. Код и релизы — схема 2 (master, теги); даты и SLA по этапам — схема 3.&lt;br&gt;• Планирование: приоритеты (ВНП) → оценка и спринт (РП с командой) → релизный тикет (Release owner) → подтверждение состава (ВНП).&lt;br&gt;• Спринт: параллельно разработка, скан и устранение уязвимостей в CI, тестирование, release notes; затем демо (QA проводит, ВНП принимает), вывод не принятых задач, фича-фриз = тег релиза.&lt;br&gt;• Стабилизация: параллельно друг другу регресс UAT, финальный скан по тегу, TOML (release notes и changelog уже готовы) и тест-план; затем устранение, Smoke UAT.&lt;br&gt;• Релиз-борд — в порядке борда; релиз-инженер НЕДРА инициирует (запуск, документ для ПСИ) и уведомляет ГПН о начале работ на PreProd; остальное — роли ГПН.&lt;br&gt;• Go/No-Go нет: после регресса PreProd релиз идёт в Прод всегда; правки — только helm, Blocker и критические дефекты — hotfix. После деплоя Smoke PROD, БД и брокеры параллельно, затем окно наблюдения." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1500" y="1634" width="3600" height="200" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="960" y="86" as="sourcePoint"/><mxPoint x="960" y="1616" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1820" y="86" as="sourcePoint"/><mxPoint x="1820" y="1616" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="2507" y="86" as="sourcePoint"/><mxPoint x="2507" y="1616" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="3647" y="86" as="sourcePoint"/><mxPoint x="3647" y="1616" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="4517" y="86" as="sourcePoint"/><mxPoint x="4517" y="1616" as="targetPoint"/>