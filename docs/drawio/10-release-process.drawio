acingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1905" y="155" width="10" height="10" as="geometry"/></mxCell><mxCell id="c35" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#140093;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1975" y="155" width="10" height="10" as="geometry"/></mxCell><mxCell id="c36" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#140093;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="2045" y="155" width="10" height="10" as="geometry"/></mxCell><mxCell id="c37" value="PR с ревью; незавершённое — за feature flag" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="185" y="172" width="560" height="16" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Не принято на демо → вывод из релиза&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7px&quot; color=&quot;#666666&quot;&gt;revert PR / отключение флага&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#FF7500;strokeWidth=1.5;fontSize=9;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="520" y="250" width="250" height="44" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=0;html=1;fillColor=#D64545;strokeColor=#D64545;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="771" y="136" width="8" height="48" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;тег EARM-N&lt;br&gt;фича-фриз (релиз-кандидат)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#D64545;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="685" y="94" width="190" height="34" as="geometry"/></mxCell><mxCell id="c43" value="стабилизация N: регресс UAT → фиксы (в master или в ветку от тега) → итоговый тег (код-фриз) → релиз-борд → PreProd → Прод" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="790" y="304" width="700" height="34" as="geometry"/></mxCell><mxCell id="c44" value="" style="rounded=0;html=1;fillColor=#019390;strokeColor=#019390;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1176" y="136" width="8" height="48" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;тег EARM-N (код-фриз)&lt;br&gt;берёт релиз-борд&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#019390;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1090" y="94" width="190" height="34" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Прод&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CFF85E;strokeColor=#140093;strokeWidth=2;fontSize=8;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1250" y="143" width="34" height="34" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=0;html=1;fillColor=#D64545;strokeColor=#D64545;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1371" y="136" width="8" height="48" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;тег EARM-N+1&lt;br&gt;фича-фриз&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#D64545;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1285" y="94" width="190" height="34" as="geometry"/></mxCell><mxCell id="c50" value="стабилизация N+1; новые фичи спринта N+2 вливаются в master за флагом" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1390" y="384" width="700" height="34" as="geometry"/></mxCell><mxCell id="c51" value="" style="rounded=0;html=1;fillColor=#019390;strokeColor=#019390;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1776" y="136" width="8" height="48" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;тег EARM-N+1&lt;br&gt;(код-фриз)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#019390;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1690" y="94" width="190" height="34" as="geometry"/></mxCell><mxCell id="c53" value="" style="rounded=0;html=1;fillColor=#D64545;strokeColor=#D64545;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1971" y="136" width="8" height="48" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;тег EARM-N+2&lt;br&gt;фича-фриз&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#D64545;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1885" y="94" width="190" height="34" as="geometry"/></mxCell><mxCell id="c56" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#904EE2;strokeColor=#904EE2;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="475" y="475" width="10" height="10" as="geometry"/></mxCell><mxCell id="c57" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#904EE2;strokeColor=#904EE2;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="615" y="475" width="10" height="10" as="geometry"/></mxCell><mxCell id="c58" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#904EE2;strokeColor=#904EE2;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="755" y="475" width="10" height="10" as="geometry"/></mxCell><mxCell id="c59" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#904EE2;strokeColor=#904EE2;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="895" y="475" width="10" height="10" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;супер-фича-ветка (опционально): PR с ревью как обычно → пакет правок тестируется целиком&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#904EE2;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="345" y="490" width="700" height="34" as="geometry"/></mxCell><mxCell id="c62" value="merge в master после приёмки;&lt;br&gt;не принято → ветка не вливается" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#904EE2;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1046" y="458" width="380" height="34" as="geometry"/></mxCell><mxCell id="c64" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D64545;strokeColor=#D64545;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1595" y="594" width="12" height="12" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;hotfix (тот же процесс, меньше объём сборки): исправление в master; если master ушёл вперёд — cherry-pick в короткоживущую ветку от тега Прода и новый тег&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#D64545;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1305" y="610" width="640" height="34" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;Сервисы живут в отдельных репозиториях: один и тот же ID релиза (Fix Version) ставится тегом в репозиториях всех сервисов релиза. Отдельных release-веток нет — нет и backport между ними.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#140093;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="180" y="660" width="1950" height="20" as="geometry"/></mxCell><mxCell id="c67" value="Соответствие этапам схемы 1: 5 — разработка и влитие в master · 9 — демо · 10 — вывод не принятых задач · 11 — фича-фриз и тег · 12–17 — стабилизация, фиксы в master · 31 — деплой в Прод." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="180" y="684" width="1950" height="20" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;Тема&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#140093;strokeWidth=1;fontSize=11;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="260" height="24" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b&gt;Правило&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#140093;strokeWidth=1;fontSize=11;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="280" y="730" width="1660" height="24" as="geometry"/></mxCell><mxCell id="c70" value="Репозитории" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="754" width="260" height="24" as="geometry"/></mxCell><mxCell id="c71" value="Каждый сервис живёт в своём репозитории; релиз — это один и тот же ID (Fix Version, например EARM26.4.1) как git-тег в репозитории каждого сервиса релиза." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="280" y="754" width="1660" height="24" as="geometry"/></mxCell><mxCell id="c72" value="master" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="778" width="260" height="24" as="geometry"/></mxCell><mxCell id="c73" value="Единая основная ветка. Все изменения — через PR с ревью (ссылка на ключ Story, кодовый инкремент, скрипты миграции). Незавершённое и рискованное — за feature flag." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="280" y="778" width="1660" height="24" as="geometry"/></mxCell><mxCell id="c74" value="Супер-фича-ветка (опционально)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="802" width="260" height="24" as="geometry"/></mxCell><mxCell id="c75" value="Для сложной фичи заводится агрегирующая ветка: PR направляются в неё как обычно, с ревью; весь пакет правок тестируется вместе и вливается в master после приёмки." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="280" y="802" width="1660" height="24" as="geometry"/></mxCell><mxCell id="c76" value="Не принято на демо" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="826" width="260" height="24" as="geometry"/></mxCell><mxCell id="c77" value="До тега задача выводится из релиза: revert PR, отключение флага или невлитая супер-фича-ветка. Задача переходит в следующий релиз." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="280" y="826" width="1660" height="24" as="geometry"/></mxCell><mxCell id="c78" value="Фича-фриз и тег" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="850" width="260" height="24" as="geometry"/></mxCell><mxCell id="c79" value="В последний день спринта на коммит master ставится тег с ID релиза (релиз-кандидат). Новые фичи следующего спринта вливаются за флагом." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="280" y="850" width="1660" height="24" as="geometry"/></mxCell><mxCell id="c80" value="Исправления стабилизации" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="874" width="260" height="38" as="geometry"/></mxCell><mxCell id="c81" value="Баги регресса и блокирующие уязвимости правятся в master и фиксируются новым тегом; если в master уже есть изменения следующего спринта (миграции, зависимости, конфиги), фикс идёт в короткоживущую ветку от тега релиза, которая живёт до деплоя. Итоговый тег — код-фриз, его берёт релиз-борд." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="280" y="874" width="1660" height="38" as="geometry"/></mxCell><mxCell id="c82" value="Защита тегов и образов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="912" width="260" height="24" as="geometry"/></mxCell><mxCell id="c83" value="Теги релизов — protected (переставить нельзя); digest образа фиксируется в TOML и проверяется при согласовании трансфера. Миграции БД — обратно совместимые (expand/contract), чтобы код следующего спринта в master не ломал релиз." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="280" y="912" width="1660" height="24" as="geometry"/></mxCell><mxCell id="c84" value="Hotfix" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="936" width="260" height="24" as="geometry"/></mxCell><mxCell id="c85" value="Критический дефект: исправление в master; если master ушёл вперёд — cherry-pick в короткоживущую ветку от тега Прода и новый тег. Идёт тем же процессом; объём сборки меньше (один-два сервиса), поэтому этапы короче." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="280" y="936" width="1660" height="24" as="geometry"/></mxCell><mxCell id="c86" value="Параллельные релизы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="260" height="24" as="geometry"/></mxCell><mxCell id="c87" value="Релизы различаются тегами, а не ветками: следующий релиз стартует, пока предыдущий в стабилизации, без отдельных release-веток и backport." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="280" y="960" width="1660" height="24" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#140093;strokeWidth=5;fontSize=10;fontColor=#140093;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="170" y="160" as="sourcePoint"/><mxPoint x="2100" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#FF7500;strokeWidth=1.5;fontSize=10;fontColor=#FF7500;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 3;endArrow=classic;endFill=1;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="700" y="250" as="sourcePoint"/><mxPoint x="700" y="166" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;h