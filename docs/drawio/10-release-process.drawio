rray></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="3. Матрица сервис × этап" name="3. Матрица сервис × этап"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1874" pageHeight="572" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object label="&lt;b&gt;Релиз-процесс · Сервис: %service% · Направление: %direction% · Релиз: %version% · Jira: REL-%service%-%version%   |   матрица «сервис × этап»: ответственный · план · факт · результат&lt;/b&gt;" placeholders="1" service="⟨СЕРВИС⟩" direction="⟨НАПРАВЛЕНИЕ⟩" version="⟨ВЕРСИЯ⟩" id="title"><mxCell style="text;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=15;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="6" width="1854" height="34" as="geometry"/></mxCell></object><mxCell id="c2" value="Одна строка-блок на сервис. Значения берутся из подзадач Jira «Этап релиза» (план/факт, исполнитель, результат). Результат: ✓ без возврата · ↩ был возврат (код E1–E7) · ✗ нарушено требование · — не применимо. Список сервисов — SERVICES в scripts/build_release_process.py." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1834" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Сервис / показатель&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="210" height="28" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b