ign=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="0" y="706" width="5220" height="230" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;НЕДРА&lt;br&gt;Релиз-инженер&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CFC9F2;strokeColor=#A0A0A0;strokeWidth=1;fontSize=11;fontColor=#140093;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="0" y="706" width="150" height="230" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4F3F2;strokeColor=#A0A0A0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="0" y="936" width="5220" height="130" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;ИБ ГПН-ЦР&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#89C9C7;strokeColor=#A0A0A0;strokeWidth=1;fontSize=11;fontColor=#140093;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="0" y="936" width="150" height="130" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F0FB;strokeColor=#A0A0A0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="0" y="1066" width="5220" height="320" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;ГПН-ЦР&lt;br&gt;DevOps · релиз-инженер сервиса · админы БД и брокеров · сервис&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#AAC3E3;strokeColor=#A0A0A0;strokeWidth=1;fontSize=11;fontColor=#140093;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="0" y="1066" width="150" height="320" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Подготовка&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#FFFFFF;strokeWidth=1;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="150" y="46" width="427" height="40" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Спринт · 2 недели&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CFF85E;strokeColor=#FFFFFF;strokeWidth=1;fontSize=12;fontColor=#140093;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="577" y="46" width="943" height="40" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Стабилизация на UAT (параллельно)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDAB64;strokeColor=#FFFFFF;strokeWidth=1;fontSize=12;fontColor=#140093;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1520" y="46" width="742" height="40" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Релиз-борд (автоматизация)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#FFFFFF;strokeWidth=1;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="2262" y="46" width="953" height="40" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;PreProd&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#FFFFFF;strokeWidth=1;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="3215" y="46" width="732" height="40" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Прод и закрытие&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#FFFFFF;strokeWidth=1;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="3947" y="46" width="1273" height="40" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CFF85E;strokeColor=#8AB800;strokeWidth=1.2;fillOpacity=14;dashed=1;dashPattern=6 3;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="581" y="86" width="949" height="1300" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;СПРИНТ: старт → создание ветки → влитие задач → тестирование → демо → фича-фриз&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#4F6600;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="587" y="88" width="620" height="16" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDAB64;strokeColor=#FF7500;strokeWidth=1.5;fillOpacity=18;dashed=1;dashPattern=6 3;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1530" y="216" width="737" height="720" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;ПАРАЛЛЕЛЬНО (между чёрными планками)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#B85500;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1536" y="218" width="560" height="16" as="geometry"/></mxCell><mxCell id="c31" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF7500;strokeWidth=2;dashed=1;dashPattern=6 3;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="2266" y="706" width="943" height="360" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;РЕЛИЗ-БОРД · автоматизированные шаги в зоне ответственности релиз-инженера НЕДРА&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#B85500;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="2272" y="708" width="760" height="16" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1  Подтверждение состава релиза&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: ВНП&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Подтверждение состава релиза
Ответственный: Владелец направления (ВНП)
Исполнители: Владелец направления (ВНП)
До сбора релизного тикета ВНП направления подтверждает, какие истории и баги должны войти в релиз, и передаёт список Release owner."><mxGeometry x="215" y="107" width="155" height="88" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2  Сбор релизного тикета&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: РП · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Сбор релизного тикета
Ответственный: Release owner
Исполнители: Release owner, Руководитель проекта (РП) направления
Release owner создаёт релизный тикет (Fix Version) из подтверждённого списка: только Story и Bug с оценкой, тест-кейсами и скриптами миграции; заводит строку в календаре и паспорт релиза."><mxGeometry x="405" y="234" width="155" height="88" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3  Сбор релизной ветки (старт спринта)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: мейнтейнеры · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Сбор релизной ветки (старт спринта)
Ответственный: Релиз-инженер НЕДРА
Исполнители: Релиз-инженер НЕДРА, Мейнтейнеры сервисов / фича-команды
В первый день спринта релиз-инженер НЕДРА вместе с мейнтейнерами создаёт релизную ветку каждого сервиса от master. Допускается вести несколько релизных веток параллельно."><mxGeometry x="595" y="724" width="155" height="88" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4  Влитие задач в релизную ветку&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: мейнтейнеры&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA спринт&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Влитие задач в релизную ветку
Ответственный: Мейнтейнеры сервисов / фича-команды
Исполнители: Мейнтейнеры сервисов / фича-команды
По ходу спринта мейнтейнеры вливают в релизную ветку закрытые задачи релиза: PR со ссылкой на ключ Story, кодовым инкрементом и скриптами миграции."><mxGeometry x="785" y="597" width="155" height="88" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5  Тестирование задач в ветке&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: QA&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: мейнтейнеры · SLA спринт&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Тестирование задач в ветке
Ответственный: Lead QA / QA команд
Исполнители: Lead QA / QA команд, Мейнтейнеры сервисов / фича-команды
QA тестирует влитые задачи на UAT; найденные дефекты возвращаются в разработку, задачи без тест-кейсов в релиз не попадают."><mxGeometry x="975" y="467" width="155" height="88" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6  Демо и приёмка задач&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: ВНП&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: QA · SLA спринт&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Демо и приёмка задач
Ответственный: Владелец направления (ВНП)
Исполнители: Lead QA / QA команд
QA проводит демо закрытых задач, ВНП принимает их. Принятые остаются в релизе; не принятые и не успевшие переносятся в следующий релиз (следующий спринт)."><mxGeometry x="1165" y="107" width="155" height="88" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;7  Фича-фриз (конец спринта)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: мейнтейнеры · SLA посл. день&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Фича-фриз (конец спринта)
Ответственный: Релиз-инженер НЕДРА
Исполнители: Релиз-инженер НЕДРА, Мейнтейнеры сервисов / фича-команды
В последний день спринта релиз-инженер НЕДРА замораживает релизную ветку: новые задачи не принимаются. Всё, что не успели, идёт в следующий релиз = следующий спринт."><mxGeometry x="1355" y="724" width="155" height="88" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;8  Регресс на UAT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: QA&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 3 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Регресс на UAT
Ответственный: Lead QA / QA команд
Исполнители: Lead QA / QA команд
Регрессионное тестирование релизной ветки по тест-плану из ТестОпс НЕДРА, заведение дефектов с критичностью, отчёт о регрессе."><mxGeometry x="1600" y="467" width="155" height="88" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;9  Скан уязвимостей (SAST, SCA, Luntry, секреты)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 3 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Скан уязвимостей (SAST, SCA, Luntry, секреты)
Ответственный: Релиз-инженер НЕДРА
Исполнители: Релиз-инженер НЕДРА
Проверки SAST, SCA, Luntry и секретов в CI по релизной ветке; отчёты — на странице «Результаты сканирования»."><mxGeometry x="1600" y="724" width="155" height="88" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b&gt;10  Подготовка TOML&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: архитектор · SLA 2 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Подготовка TOML
Ответственный: Release owner
Исполнители: Release owner, Архитектор (ревью TOML)
Release owner готовит TOML-файл, архитектор проводит ревью. TOML нужен для запуска аудита через релиз-борд."><mxGeometry x="1600" y="234" width="155" height="88" as="geometry"/></mxCell><mxCell id="s11" value="&lt;b&gt;11  Импорт тест-плана в ТестОпс ГПН-ЦР&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: QA · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Импорт тест-плана в ТестОпс ГПН-ЦР
Ответственный: Release owner
Исполнители: Release owner, Lead QA / QA команд
QA валидирует и финализирует тест-план, Release owner импортирует его в ТестОпс ГПН-ЦР для регресса на PreProd."><mxGeometry x="1600" y="342" width="155" height="88" as="geometry"/></mxCell><mxCell id="s12" value="&lt;b&gt;12  Устранение багов UAT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: мейнтейнеры&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 3 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Устранение багов UAT
Ответственный: Мейнтейнеры сервисов / фича-команды
Исполнители: Мейнтейнеры сервисов / фича-команды
Фича-команды исправляют дефекты по отчёту регресса; распределение багов по разработчикам — РП направления. Фиксы вливаются в релизную ветку."><mxGeometry x="1845" y="597" width="155" height="88" as="geometry"/></mxCell><mxCell id="s13" value="&lt;b&gt;13  Устранение уязвимостей&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: мейнтейнеры · SLA 3 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Устранение уязвимостей
Ответственный: Релиз-инженер НЕДРА
Исполнители: Мейнтейнеры сервисов / фича-команды, Релиз-инженер НЕДРА
Мейнтейнеры закрывают blocker/critical уязвимости, релиз-инженер НЕДРА контролирует; допускается только согласованное исключение. Этап заканчивается код-фризом: версия для аудита зафиксирована."><mxGeometry x="1845" y="832" width="155" height="88" as="geometry"/></mxCell><mxCell id="s14" value="&lt;b&gt;14  Smoke UAT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: QA&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 2 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Smoke UAT
Ответственный: Lead QA / QA команд
Исполнители: Lead QA / QA команд
Короткая проверка релизной ветки после исправлений. Критические дефекты возвращают на устранение; иначе релиз-инженер НЕДРА запускает релиз-борд."><mxGeometry x="2090" y="467" width="155" height="88" as="geometry"/></mxCell><mxCell id="s15" value="&lt;b&gt;15  Аудит кода&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: ИБ ГПН, релиз-борд · SLA 5 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#019390;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Аудит кода
Ответственный: Релиз-инженер НЕДРА
Исполнители: ИБ ГПН (AppSec, Compliance), релиз-борд (автоматически)
Релиз-инженер НЕДРА запускает аудит через релиз-борд, ИБ проводит аудит кода. Замечания возвращаются на устранение уязвимостей."><mxGeometry x="2280" y="957" width="155" height="88" as="geometry"/></mxCell><mxCell id="s16" value="&lt;b&gt;16  Выкатка на UAT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: релиз-борд · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Выкатка на UAT
Ответственный: Релиз-инженер НЕДРА
Исполнители: релиз-борд (автоматически)
Автоматическая выкатка проверенной версии на UAT через релиз-борд."><mxGeometry x="2470" y="724" width="155" height="88" as="geometry"/></mxCell><mxCell id="s17" value="&lt;b&gt;17  Функциональное тестирование&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: релиз-борд · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Функциональное тестирование
Ответственный: Релиз-инженер НЕДРА
Исполнители: релиз-борд (автоматически)
Автоматическое функциональное тестирование на UAT через релиз-борд."><mxGeometry x="2660" y="724" width="155" height="88" as="geometry"/></mxCell><mxCell id="s18" value="&lt;b&gt;18  ПСИ ИБ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: ИБ ГПН · SLA 0 дн (не нужен) / до 5 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#019390;strokeWidth=1.3;dashed=1;dashPattern=6 3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="ПСИ ИБ
Ответственный: Релиз-инженер НЕДРА
Исполнители: Релиз-инженер НЕДРА, ИБ ГПН (AppSec, Compliance)
Если ПСИ не нужен — релиз-инженер НЕДРА сразу пропускает шаг в релиз-борде (0 дней). Если нужен — загружает документ, ИБ проводит и принимает ПСИ (до 5 дней)."><mxGeometry x="2850" y="957" width="155" height="88" as="geometry"/></mxCell><mxCell id="s19" value="&lt;b&gt;19  Согласование трансфера на ПРОД&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: ИБ ГПН · SLA 5 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#019390;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Согласование трансфера на ПРОД
Ответственный: Релиз-инженер НЕДРА
Исполнители: ИБ ГПН (AppSec, Compliance)
ИБ ГПН согласует перенос образов в ПРОД-сегмент; приоритизацию задаёт Release owner."><mxGeometry x="3040" y="957" width="155" height="88" as="geometry"/></mxCell><mxCell id="s20" value="&lt;b&gt;20  Выкатка на PreProd&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: релиз-инженер НЕДРА&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: DevOps · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Выкатка на PreProd
Ответственный: Релиз-инженер НЕДРА
Исполнители: DevOps / инфра
DevOps выкатывает согласованную сборку на PreProd."><mxGeometry x="3285" y="1084" width="155" height="88" as="geometry"/></mxCell><mxCell id="s21" value="&lt;b&gt;21  БД PreProd: миграции&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: админ БД&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="БД PreProd: миграции
Ответственный: Администратор БД
Исполнители: Администратор БД
Администратор БД применяет скрипты миграции на PreProd и подтверждает готовность."><mxGeometry x="3285" y="1192" width="155" height="88" as="geometry"/></mxCell><mxCell id="s22" value="&lt;b&gt;22  Брокеры PreProd: топики и настройки&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: админ брокеров&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Брокеры PreProd: топики и настройки
Ответственный: Администратор брокеров
Исполнители: Администратор брокеров
Администратор брокеров применяет топики и настройки на PreProd и подтверждает готовность."><mxGeometry x="3285" y="1300" width="155" height="88" as="geometry"/></mxCell><mxCell id="s23" value="&lt;b&gt;23  Регресс на PreProd&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: сервис ГПН-ЦР · SLA 3 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Регресс на PreProd
Ответственный: Release owner
Исполнители: Release owner, Сервис ГПН-ЦР (проектная / сервисная сделка)
Release owner и сервис ГПН-ЦР проводят регресс на PreProd по тест-плану из ТестОпс ГПН-ЦР."><mxGeometry x="3530" y="234" width="155" height="88" as="geometry"/></mxCell><mxCell id="s24" value="&lt;b&gt;24  Проверка функционала на PreProd&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: ВНП&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 3 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Проверка функционала на PreProd
Ответственный: Владелец направления (ВНП)
Исполнители: Владелец направления (ВНП)
ВНП проверяет функционал релиза на PreProd параллельно регрессу; замечания идут в отчёт."><mxGeometry x="3530" y="107" width="155" height="88" as="geometry"/></mxCell><mxCell id="s25" value="&lt;b&gt;25  Отчёт о регрессе PreProd&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Отчёт о регрессе PreProd
Ответственный: Release owner
Исполнители: Release owner
Release owner готовит отчёт. Релиз идёт в Прод в любом случае; правки возможны только на уровне helm, критические дефекты включаются в hotfix."><mxGeometry x="3775" y="234" width="155" height="88" as="geometry"/></mxCell><mxCell id="s26" value="&lt;b&gt;26  Уведомление пользователей, release notes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: техписатель, PMM · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Уведомление пользователей, release notes
Ответственный: Release owner
Исполнители: Технический писатель, PMM / коммуникации
Технический писатель готовит release notes, PMM рассылает уведомление пользователям."><mxGeometry x="3965" y="234" width="155" height="88" as="geometry"/></mxCell><mxCell id="s27" value="&lt;b&gt;27  Деплой в Прод&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: релиз-инженер сервиса · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Деплой в Прод
Ответственный: Release owner
Исполнители: Релиз-инженер сервиса (деплой в Прод), Release owner
Релиз-инженер сервиса вместе с Release owner выкатывает релиз в Прод."><mxGeometry x="4155" y="1084" width="155" height="88" as="geometry"/></mxCell><mxCell id="s28" value="&lt;b&gt;28  Smoke PROD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: сервис ГПН-ЦР&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Smoke PROD
Ответственный: Сервис ГПН-ЦР (проектная / сервисная сделка)
Исполнители: Сервис ГПН-ЦР (проектная / сервисная сделка)
Сервис ГПН-ЦР проверяет релиз в Проде и мониторинг."><mxGeometry x="4400" y="1084" width="155" height="88" as="geometry"/></mxCell><mxCell id="s29" value="&lt;b&gt;29  БД: пост-миграции&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: админ БД&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="БД: пост-миграции
Ответственный: Администратор БД
Исполнители: Администратор БД
Администратор БД применяет пост-миграции в Проде."><mxGeometry x="4400" y="1192" width="155" height="88" as="geometry"/></mxCell><mxCell id="s30" value="&lt;b&gt;30  Брокеры: настройки в Проде&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: админ брокеров&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#4895EB;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Брокеры: настройки в Проде
Ответственный: Администратор брокеров
Исполнители: Администратор брокеров
Администратор брокеров применяет настройки брокеров в Проде."><mxGeometry x="4400" y="1300" width="155" height="88" as="geometry"/></mxCell><mxCell id="s31" value="&lt;b&gt;31  Коммуникация ВНП с пользователями&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: ВНП&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: PMM · SLA 2 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Коммуникация ВНП с пользователями
Ответственный: Владелец направления (ВНП)
Исполнители: Владелец направления (ВНП), PMM / коммуникации
После выката в Прод ВНП общается с пользователями: сообщает результат релиза, собирает обратную связь, обращения передаёт в техподдержку."><mxGeometry x="4645" y="107" width="155" height="88" as="geometry"/></mxCell><mxCell id="s32" value="&lt;b&gt;32  Закрытие релиза и ретро&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;отв.: Release owner&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;исп.: скрам-мастер, админ проекта · SLA 1 дн&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.3;fontSize=10.5;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" tooltip="Закрытие релиза и ретро
Ответственный: Release owner
Исполнители: Release owner, Скрам-мастер направления, Администратор проекта (ИСУП, 1С УПП, Jira)
Release owner закрывает релиз и календарь; скрам-мастер проводит ретро; администратор проекта переносит ТРЗ задач этапов в ИСУП и 1С УПП."><mxGeometry x="4835" y="234" width="155" height="88" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="171" y="137" width="28" height="28" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="5030" y="264" width="28" height="28" as="geometry"/></mxCell><mxCell id="F1" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1550" y="258" width="8" height="530" as="geometry"/></mxCell><mxCell id="J1" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1795" y="491" width="8" height="405" as="geometry"/></mxCell><mxCell id="J2" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="2040" y="491" width="8" height="405" as="geometry"/></mxCell><mxCell id="F2" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=c