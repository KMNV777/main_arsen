<mxfile host="app.diagrams.net" agent="drawio_kit.py" version="24.7.0"><diagram id="1. Процесс" name="1. Процесс"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5220" pageHeight="1636" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object label="&lt;b&gt;Процесс выпуска релиза ЕАРМ · Сервис: %service% · Направление: %direction% · Релиз: %version%   |   последовательность и параллельность по зонам ответственности&lt;/b&gt;" placeholders="1" service="⟨СЕРВИС⟩" direction="⟨ЕАРМ1–6⟩" version="⟨27.x.y⟩" id="title"><mxCell style="text;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=15;fontColor=#140093;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="6" width="5200" height="34" as="geometry"/></mxCell></object><mxCell id="c2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEEBFA;strokeColor=#A0A0A0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="0" y="86" width="5220" height="130" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;НЕДРА&lt;br&gt;ВНП&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C9C4F0;strokeColor=#A0A0A0;strokeWidth=1;fontSize=11;fontColor=#140093;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="0" y="86" width="150" height="130" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEAF9;strokeColor=#A0A0A0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="0" y="216" width="5220" height="230" as="geometry"/