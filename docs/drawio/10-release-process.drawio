="1484" width="100" height="16" as="geometry"/></mxCell><mxCell id="c1299" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8ED15A;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="490" y="1486" width="12" height="12" as="geometry"/></mxCell><mxCell id="c1300" value="50–100 %" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="506" y="1484" width="100" height="16" as="geometry"/></mxCell><mxCell id="c1301" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBAE40;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="610" y="1486" width="12" height="12" as="geometry"/></mxCell><mxCell id="c1302" value="100–150 %" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="626" y="1484" width="100" height="16" as="geometry"/></mxCell><mxCell id="c1303" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F26B43;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="730" y="1486" width="12" height="12" as="geometry"/></mxCell><mxCell id="c1304" value="&amp;gt; 150 %" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="746" y="1484" width="100" height="16" as="geometry"/></mxCell><mxCell id="c1305" value="&lt;b&gt;Правила стратегического планирования&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=14;fontColor=#140093;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="1520" width="900" height="22" as="geometry"/></mxCell><mxCell id="c1306" value="1. Календарь релизов утверждается на скользящий год и пересматривается раз в квартал вместе с Релизным Epic.&lt;br&gt;2. Старт релиза допускается, только если у РИ, ИБ и QA в окне этапов запас по загрузке; иначе релиз сдвигается на спринт.&lt;br&gt;3. Число сервисов N планируется от ёмкости: часы по ролям при N не превышают 100 % FTE роли в пиковую неделю.&lt;br&gt;4. ПСИ ИБ закладывается в окно до старта релиза; релиз с ПСИ не стартует параллельно другому релизу с ПСИ.&lt;br&gt;5. Окна без релизных работ: новогодние и длительные майские праздники.&lt;br&gt;6. Сдвиг релиза — решение Release owner по согласованию с ВНП; причина фиксируется в календаре.&lt;br&gt;7. Hotfix вне календаря: тот же процесс, учитывается в нагрузке как резерв." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="1548" width="2160" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="7. Экономика и ресурсы" name="7. Экономика и ресурсы"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1262" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object label="&lt;b&gt;Процесс выпуска релиза ЕАРМ · Сервис: %service% · Направление: %direction% · Релиз: %version%   |   экономическая эффективность: избыток и нехватка ресурсов по ролям&lt;/b&gt;" placeholders="1" service="⟨СЕРВИС⟩" direction="⟨ЕАРМ1–6⟩" version="⟨27.x.y⟩" id="title"><mxCell style="text;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=15;fontColor=#140093;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="6" width="1680" height="34" as="geometry"/></mxCell></object><mxCell id="c2" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DDEE;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="380" height="84" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;17.0&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=24;fontColor=#140093;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="32" y="62" width="356" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;FTE списывается сейчас&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="32" y="96" width="356" height="20" as="geometry"/></mxCell><mxCell id="c5" value="1 FTE на каждую из 17 ролей" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#5E5E5E;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="32" y="114" width="356" height="22" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF