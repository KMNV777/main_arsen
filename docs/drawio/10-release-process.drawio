ddle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="612" y="1578" width="500" height="18" as="geometry"/></mxCell><mxCell id="c114" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;strokeWidth=1.5;dashed=1;dashPattern=6 3;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="570" y="1606" width="34" height="20" as="geometry"/></mxCell><mxCell id="c115" value="есть на прежней схеме, нет в эталоне — уточнить" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="612" y="1608" width="500" height="18" as="geometry"/></mxCell><mxCell id="c116" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="570" y="1636" width="34" height="20" as="geometry"/></mxCell><mxCell id="c117" value="gate / решение / AND-join" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="612" y="1638" width="500" height="18" as="geometry"/></mxCell><mxCell id="c119" value="возврат / отклонение: новая задача того же шага + код E1–E7 + этап внесения" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1218" y="1576" width="600" height="18" as="geometry"/></mxCell><mxCell id="c121" value="зависимость / готовность (не основной поток)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1218" y="1606" width="600" height="18" as="geometry"/></mxCell><mxCell id="c123" value="привязка шага к состоянию git-ветки" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1218" y="1636" width="600" height="18" as="geometry"/></mxCell><mxCell id="c124" value="&lt;b&gt;Как схема связана с эталоном ЕАРМ, Jira и метриками&lt;/b&gt;&lt;br&gt;• Нумерация шагов повторяет этапы эталона (0–12): «эт. N» в каждом блоке. ЗО и ФИО — из §14.1/§15 эталона; Gate ИБ — этапы 2, 3b, 5, 6, 8.&lt;br&gt;• Один шаг = одна задача Jira с ID шага, оценкой и полем «Сервис»; шаги по сервисам — под-задачи. Старт = «В работе», финиш = «Готово».&lt;br&gt;• Время работы = Готово − Старт; ожидание = Старт − Готово последнего предшественника (для P — от fork); AND-join G1 ждёт самый медленный трек.&lt;br&gt;• Возврат (красная стрелка) = новая задача того же шага + ссылка «Возврат из» + код ошибки E1–E7 + этап внесения (где ошибка допущена) и этап обнаружения.&lt;br&gt;• Календарь и паспорт в Confluence — витрина для менеджмента; источник метрик — Jira. Расхождения источников и пробелы — стр. 5 и docs/release-process-review.md." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1900" y="1556" width="2900" height="170" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="737" y="86" as="sourcePoint"/><mxPoint x="737" y="1536" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1290" y="86" as="sourcePoint"/><mxPoint x="1290" y="1536" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="2217" y="86" as="sourcePoint"/><mxPoint x="2217" y="1536" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="3117" y="86" as="sourcePoint"/><mxPoint x="3117" y="1536" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="3837