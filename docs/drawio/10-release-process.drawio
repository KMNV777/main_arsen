xCell><mxCell id="c76" value="&lt;b&gt;Hotfix: тот же процесс&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#666666&quot;&gt;критические дефекты PreProd → hotfix; релиз всё равно идёт в Прод&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFD2A6;strokeColor=#FF7500;strokeWidth=1.5;fontSize=10;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="3775" y="724" width="160" height="88" as="geometry"/></mxCell><mxCell id="c90" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A0A0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="0" y="1392" width="5220" height="210" as="geometry"/></mxCell><mxCell id="c91" value="&lt;b&gt;Как читать схему&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#140093;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="1404" width="300" height="18" as="geometry"/></mxCell><mxCell id="c92" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.4;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="1424" width="34" height="20" as="geometry"/></mxCell><mxCell id="c93" value="этап: в дорожке — ответственный; в подписи — исполнители и SLA" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="52" y="1426" width="520" height="18" as="geometry"/></mxCell><mxCell id="c94" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE9D2;strokeColor=#140093;strokeWidth=1.4;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="1452" width="34" height="20" as="geometry"/></mxCell><mxCell id="c95" value="параллельные этапы (между чёрными планками)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="52" y="1454" width="520" height="18" as="geometry"/></mxCell><mxCell id="c96" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FBD0;strokeColor=#140093;strokeWidth=1.4;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="1480" width="34" height="20" as="geometry"/></mxCell><mxCell id="c97" value="автоматизированный шаг релиз-борда" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="52" y="1482" width="520" height="18" as="geometry"/></mxCell><mxCell id="c98" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#140093;strokeWidth=1.4;dashed=1;dashPattern=6 3;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="1508" width="34" height="20" as="geometry"/></mxCell><mxCell id="c99" value="шаг, который пропускается, если не нужен (ПСИ ИБ)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="52" y="1510" width="520" height="18" as="geometry"/></mxCell><mxCell id="c101" value="возврат на доработку" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="708" y="1424" width="560" height="18" as="geometry"/></mxCell><mxCell id="c103" value="зависимость (нужно к началу следующего этапа)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="708" y="1452" width="560" height="18" as="geometry"/></mxCell><mxCell id="c105" value="переход в следующий релиз / hotfix" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="708" y="1480" width="560" height="18" as="geometry"/></mxCell><mxCell id="c106" value="&lt;b&gt;Основные правила&lt;/b&gt;&lt;br&gt;• Нумерация этапов сквозная, 1–32. Ветки вынесены на схему 2; даты и SLA по этапам — на схеме 3.&lt;br&gt;• Спринт 2 недели: создание релизной ветки в первый день → влитие задач → тестирование → демо (проводит QA, принимает ВНП) → фича-фриз в конце спринта. Что не успели — в следующий релиз.&lt;br&gt;• После фича-фриза параллельно идут регресс на UAT, скан уязвимостей, подготовка TOML и импорт тест-плана; затем параллельно устраняются баги и уязвимости; затем Smoke UAT.&lt;br&gt;• Релиз-борд (аудит → выкатка на UAT → функциональное тестирование → ПСИ ИБ → согласование трансфера) — в зоне релиз-инженера НЕДРА; ПСИ ИБ пропускается сразу, если не нужен.&lt;br&gt;• Go/No-Go нет: после регресса на PreProd релиз идёт в Прод; правки — только на уровне helm, критические дефекты — в hotfix. После деплоя Smoke PROD, БД и брокеры идут параллельно.&lt;br&gt;• Один этап — один ответственный; исполнители — только перечисленные роли, чужую работу никто не выполняет." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1300" y="1404" width="3600" height="190" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="577" y="86" as="sourcePoint"/><mxPoint x="577" y="1386" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1520" y="86" as="sourcePoint"/><mxPoint x="1520" y="1386" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="2262" y="86" as="sourcePoint"/><mxPoint x="2262" y="1386" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=