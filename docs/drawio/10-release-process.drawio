gn=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1000" y="1098" width="160" height="22" as="geometry"/></mxCell><mxCell id="c164" value="Итого" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="1120" width="420" height="22" as="geometry"/></mxCell><mxCell id="c165" value="5.69" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="440" y="1120" width="200" height="22" as="geometry"/></mxCell><mxCell id="c166" value="17.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="640" y="1120" width="180" height="22" as="geometry"/></mxCell><mxCell id="c167" value="+11.31" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="820" y="1120" width="180" height="22" as="geometry"/></mxCell><mxCell id="c168" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1000" y="1120" width="160" height="22" as="geometry"/></mxCell><mxCell id="c169" value="Занятость релизом: FTE = ТРЗ за год / (рабочие часы × 80 %); ТРЗ этапа = (F + S × N) × k. Стоимость = FTE × рабочие часы года × ставка роли — ставки в схему не вносятся, вводятся в калькуляторе общего HTML.&lt;br&gt;«Норма» — отклонение не более ±20 % от списания. Часы по этапам и N — стартовые допущения, заменить фактом списаний по задачам этапов в Jira. Мейнтейнеры и QA — пулы людей: «нехватка 1 FTE» = пул больше одного человека." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="1156" width="1660" height="100" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#C7D4DE;strokeWidth=1;fontSize=10;fontColor=#C7D4DE;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="550" y="244" as="sourcePoint"/><mxPoint x="550" y="694" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
