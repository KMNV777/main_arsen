ddle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="572" y="1126" width="460" height="18" as="geometry"/></mxCell><mxCell id="c102" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="530" y="1154" width="34" height="20" as="geometry"/></mxCell><mxCell id="c103" value="шлюз: решение / AND-join" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="572" y="1156" width="460" height="18" as="geometry"/></mxCell><mxCell id="c105" value="возврат / отклонение: фиксируется в Jira со ссылкой «Возврат из» и кодом E1–E7" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1158" y="1126" width="380" height="18" as="geometry"/></mxCell><mxCell id="c107" value="зависимость / готовность (не основной поток)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1158" y="1156" width="380" height="18" as="geometry"/></mxCell><mxCell id="c109" value="привязка шага к состоянию git-ветки" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1158" y="1186" width="380" height="18" as="geometry"/></mxCell><mxCell id="c110" value="&lt;b&gt;Как это ложится в Jira и в метрики&lt;/b&gt;&lt;br&gt;• Релиз-тикет REL-&amp;lt;сервис&amp;gt;-&amp;lt;версия&amp;gt; + подзадача «Этап релиза» на каждый блок схемы; ключ шага = ID на схеме (0.1 … 5.5, G1, G2). Поле «Сервис» — обязательное.&lt;br&gt;• Старт шага = переход «В работе», финиш = «Готово». Время работы = Готово − Старт; ожидание = Старт − Готово предшественника (для P — от fork).&lt;br&gt;• Возврат (красная пунктирная стрелка) = новая подзадача того же шага + ссылка на шаг-источник + код ошибки E1–E7. Так видно, где ошибка внесена и где найдена.&lt;br&gt;• ЗО = дорожка. Метрики режутся по сервису, ЗО, шагу и исполнителю — детали на стр. 3–4." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1700" y="1106" width="2600" height="130" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="770" y="86" as="sourcePoint"/><mxPoint x="770" y="1086" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor=#9A9A9A;strokeWidth=1;fontSize=10;fontColor=#9A9A9A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;endArrow=none;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1540" y="86" as="sourcePoint"/><mxPoint x="1540" y="1086" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;orthogonalLoop=1;strokeColor