alue="" style="rounded=0;html=1;fillColor=#D64545;strokeColor=#D64545;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1966" y="532" width="8" height="36" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Прод&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CFF85E;strokeColor=#140093;strokeWidth=2;fontSize=8;fontColor=#1B1B3A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="2156" y="535" width="30" height="30" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;release/&amp;lt;сервис&amp;gt;/N+2&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#4895EB;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1450" y="514" width="420" height="18" as="geometry"/></mxCell><mxCell id="c40" value="старт спринта: сбор ветки" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="185" y="272" width="130" height="30" as="geometry"/></mxCell><mxCell id="c41" value="влитие задач" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="300" y="272" width="180" height="18" as="geometry"/></mxCell><mxCell id="c42" value="тестирование и демо (QA · ВНП)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="480" y="272" width="260" height="18" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;фича-фриз&lt;br&gt;(конец спринта)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#D64545;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="690" y="192" width="180" height="30" as="geometry"/></mxCell><mxCell id="c44" value="стабилизация и выкат: регресс UAT → устранение → Smoke UAT → релиз-борд → PreProd → деплой в Прод" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=9;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="800" y="264" width="780" height="18" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;не принято и не успели →&lt;br&gt;следующий релиз (= следующий спринт)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#B85500;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="808" y="298" width="380" height="44" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;не принято и не успели →&lt;br&gt;следующий релиз (= следующий спринт)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#B85500;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1408" y="448" width="380" height="44" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;hotfix/* — от ветки Прода; тот же процесс&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#D64545;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1650" y="578" width="520" height="18" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Допускается вести несколько релизных веток параллельно: ветка N+1 создаётся на старте следующего спринта, пока ветка N проходит стабилизацию и выкат.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#140093;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="180" y="625" width="1900" height="20" as="geometry"/></mxCell><mxCell id="c52" value="Соответствие этапам схемы 1:  3 — сбор ветки · 4 — влитие задач · 5 — тестирование · 6 — демо и приёмка · 7 — фича-фриз · 8–14 — стабилизация на UAT · 15–19 — релиз-борд · 20–25 — PreProd · 27 — деплой в Прод" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="180" y="655" width="1950" height="20" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Шаг&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#140093;strokeWidth=1;fontSize=11;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="220" height="24" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Правило&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#140093;strokeColor=#140093;strokeWidth=1;fontSize=11;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="240" y="700" width="1700" height="24" as="geometry"/></mxCell><mxCell id="c55" value="Старт спринта" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="724" width="220" height="24" as="geometry"/></mxCell><mxCell id="c56" value="В первый день спринта релиз-инженер НЕДРА вместе с мейнтейнерами создаёт релизную ветку каждого сервиса от master. Имя: release/&amp;lt;сервис&amp;gt;/&amp;lt;версия&amp;gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="240" y="724" width="1700" height="24" as="geometry"/></mxCell><mxCell id="c57" value="Влитие задач" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="748" width="220" height="24" as="geometry"/></mxCell><mxCell id="c58" value="Только Story и Bug из релизного тикета: с оценкой, тест-кейсами, кодовым инкрементом (PR со ссылкой на ключ Story) и скриптами миграции." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="240" y="748" width="1700" height="24" as="geometry"/></mxCell><mxCell id="c59" value="Тестирование и демо" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="772" width="220" height="24" as="geometry"/></mxCell><mxCell id="c60" value="QA тестирует влитые задачи и проводит демо, ВНП принимает. Не принятые задачи остаются в разработке." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="240" y="772" width="1700" height="24" as="geometry"/></mxCell><mxCell id="c61" value="Фича-фриз" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="796" width="220" height="24" as="geometry"/></mxCell><mxCell id="c62" value="В последний день спринта ветка замораживается. Новые задачи не принимаются; не успевшие и не принятые — в следующий релиз = следующий спринт." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="240" y="796" width="1700" height="24" as="geometry"/></mxCell><mxCell id="c63" value="Параллельные ветки" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="220" height="24" as="geometry"/></mxCell><mxCell id="c64" value="Допускается несколько релизных веток одновременно: ветка следующего релиза создаётся на старте следующего спринта, пока предыдущая проходит стабилизацию и выкат." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;strokeWidth=1;fontSize=11;fontColor=#1B1B3A;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="240" y="820" width="1700" hei