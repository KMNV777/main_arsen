    classDef kspd fill:#eef4fb,stroke:#4a73b5,stroke-width:1px,color:#222;
    classDef dzo fill:#f3f7f3,stroke:#5d8b5b,stroke-width:1px,color:#222;
    classDef caas fill:#f7f7ff,stroke:#6a67ce,stroke-width:1px,color:#222;
    classDef ext fill:#fff8ec,stroke:#c79a4b,stroke-width:1px,color:#222;
    classDef svc fill:#ffffff,stroke:#8a8a8a,stroke-width:1px,color:#222;
    classDef data fill:#edf5ff,stroke:#4a73b5,stroke-width:1px,color:#222;

    class KSPD kspd;
    class DZO1,DZO2 dzo;
    class CAAS caas;
    class EXT perimeter;
    class RT,CG,ABAI,NDT,AUTH,OPC1,ASUTP1,COL1,FW1,MES1,OPC2,ASUTP2,COL2,FW2,FRONT,KEY,NGINX,CFG,RES,LOGON,SCR,VCON,VDATA,DPROC,DIAG,VLIB,VPROJ,DEV,FCC,WEB,VLOG,VNOTIF,RABBIT,ES,DAL,IBUS svc;
    class DB,S3,EXTDB data;
