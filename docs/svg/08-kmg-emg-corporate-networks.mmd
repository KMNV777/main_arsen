        KC["КЦ КМГ"]
        EMGorg["АО «Эмбамунайгаз»"]
        KMGI["КМГИ"]
    end

    subgraph NetEMG["Корпоративная сеть / цифровой контур ЭМГ"]
        subgraph CoreEMG["Ядро цифровизации ЭМГ"]
            ABAI["ИС ABAI<br/>abai.kmg.kz"]
            UTOEMG["ИС «УТО ЭМГ»"]
            ASDC["АСДЦ<br/>iis.thkmg.kz"]
        end
        subgraph IM["ИМ · OT-хаб · 10.32.10.99"]
            IMnode["Интеллектуальное месторождение"]
        end
        subgraph OT["Промышленный контур OT"]
            ISUN["ИСУН"]
            ASUTP["АСУТП / ТМ"]
            AGZU["ТМ АГЗУ"]
            KUUN["КУУН НПС-3"]
            SDMO["СДМО"]
            KTM["KTM Floboss"]
        end
    end

    subgraph NetKMG["Корпоративная сеть группы КМГ"]
        subgraph CorpIS["Бизнес-системы и порталы"]
            SAPFIR["СЭД / САПФИР"]
            ISOT["ИСОТ / ЭНД"]
            SDD["СДД"]
            Procu["Procu / Price"]
            BDA["БДА"]
            Team["Портал Team"]
            Intranet["Интранет"]
            ISUP["ИСУП"]
            Compliance["Compliance"]
            UTO["ИС «УТО»"]
            SP["sPoint"]
            KGIS["КГИС"]
            Argus["Argus Pro"]
        end
        subgraph Docs["Документооборот и архив"]
            Alfresco["Alfresco"]
            EA["Электронный архив"]
        end
        subgraph SAPBlock["SAP ERP — хаб"]
            SAPP["SAP ERP"]
            AVR["AVR"]
        end
        subgraph Finance["Финансы и планирование"]
            SAS["SAS-FM"]
            FC["FC"]
            NB["Нацбанк"]
            BV["БВУ"]
            Platts["Platts"]
            ISEF["ИС ЭСФ"]
            ZUP["1С зарплата"]
            SIZ["СИЗ"]
        end
        subgraph HR["Кадры"]
            UP["Управление персоналом"]
            EPASS["E-Pass"]
        end
